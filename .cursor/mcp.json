{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${BKIT_GH_TOKEN}"
      }
    },
    "serena": {
      "type": "stdio",
      "command": "${HOME}/.local/bin/serena",
      "args": ["start-mcp-server", "--context", "ide", "--project-from-cwd"]
    }
  }
}
