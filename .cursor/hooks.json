{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": ".cursor/hooks/preflight.sh", "failClosed": true }
    ],
    "sessionStop": [{ "command": "echo '[bkit] session stopped'" }],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guardrails.cjs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/guardrails.cjs",
        "matcher": "Read|TabRead",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/gateguard.cjs",
        "matcher": "Write"
      }
    ]
  }
}
