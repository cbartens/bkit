{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/bkit-preflight.sh",
        "failClosed": true
      }
    ],
    "sessionStop": [
      {
        "command": "echo '[bkit] session stopped'"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/bkit-guardrails.cjs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/bkit-guardrails.cjs",
        "matcher": "Read|TabRead",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/bkit-gateguard.cjs",
        "matcher": "Write"
      }
    ]
  }
}
