{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".agents/scripts",
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [".agents/scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "tmp", ".worktrees", ".agents/skills", "**/*.test.ts"]
}
