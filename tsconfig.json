{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".bkit/core/engine",
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [".bkit/core/engine/**/*.ts"],
  "exclude": ["node_modules", "dist", "tmp", ".worktrees", "**/*.test.ts"]
}
