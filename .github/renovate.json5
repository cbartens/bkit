// Renovate configuration shipped by bkit.
// Tier 1 (canonical-overwrite): bkit owns this file. Rewritten on every
// `bkit install`. Do NOT edit by hand — changes will be overwritten.
//
// Reference: https://docs.renovatebot.com/configuration-options/
//
// Renovate App install is one-click via GitHub UI (https://github.com/apps/renovate).
// No `gh api` equivalent exists. See bkit issue #123 for the migration prompt.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Extend Renovate's curated baseline. `config:recommended` enables the
  // sensible defaults (timezone-aware schedules, dependency-dashboard, etc.).
  //
  // `local>cbartens/bkit//.github/renovate-local.json5` pulls in `.github/renovate-local.json5`,
  // a CONSUMER-OWNED file bkit does NOT manage. This file (renovate.json5) is
  // Tier-1 canonical-overwrite — rewritten on every `bkit install` — so hand-edits
  // here are clobbered. Put repo-specific Renovate rules in renovate-local.json5
  // instead; they survive `bkit install`/`bkit upgrade`. It's listed LAST so it
  // wins over the presets above. Precedence caveat: extended-preset packageRules
  // are evaluated BEFORE this config's inline packageRules below, so renovate-local
  // can ADD rules and set keys bkit leaves unset (notably `enabled: false` to fence
  // a package — bkit never sets `enabled: true`), but it canNOT override a key bkit
  // sets explicitly (e.g. `automerge`). Renovate resolves the preset from the
  // DEFAULT branch; append `#<branch>` to resolve from another branch.
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    "local>cbartens/bkit//.github/renovate-local.json5",
  ],

  // bkit consumers gate `main` to PRs-from-`dev`-only. Renovate must open
  // PRs against `dev`, not the default branch.
  baseBranches: ["dev"],

  // Renovate reads its config ONLY from the repository's default branch (`main`).
  // With `baseBranches: ["dev"]` and this unset, edits to `renovate.json5` on `dev`
  // are invisible to Renovate — every config change would otherwise need a release
  // to `main` to take effect. `merge` layers `dev`'s config over `main`'s for the
  // dev-targeted runs, so ongoing config edits can live on `dev`. Bootstrap caveat:
  // this option is itself read from `main`, so it needs ONE merge to `main` before
  // dev-side config edits are honored. See docs/deployments.md § GitHub Actions pinning.
  useBaseBranchConfig: "merge",

  // Weekly batched runs — keeps PR noise low. CVE-driven updates fire
  // immediately regardless of schedule via `osvVulnerabilityAlerts`.
  schedule: ["before 6am on Monday"],
  timezone: "UTC",

  // CVE alerts → Renovate opens a PR immediately, bypassing the weekly schedule.
  // Equivalent to Dependabot's `automated-security-fixes` but routed to `dev`
  // (via baseBranches above) so bkit branch protection accepts them.
  osvVulnerabilityAlerts: true,

  // Conventional-commit prefix to match the rest of the repo history.
  commitMessagePrefix: "chore(deps):",

  // Lockfile maintenance — picks up indirect-dependency updates that a
  // direct-dependency bump alone wouldn't catch. Same weekly slot.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on Monday"],
  },

  // Respect ignore paths from .gitignore + add common monorepo cruft.
  // `.agents/templates/**` and `.agents/skills/**` are bkit-owned mirrors written
  // into the consumer working tree by `bkit install`/`bkit upgrade` (not consumer
  // source). Their workflow SHAs, Cursor Dockerfile, and vendored skill manifests
  // are refreshed by bkit, NOT consumer Renovate — scanning them only produces
  // onboarding noise (and an unauthable `@cbartens/bkit` lookup). See issue #132.
  // `bkit-cloud.yml` is bkit-owned too and tag-pinned by design (new SHAs arrive
  // via `bkit install`). It MUST be ignored here, not merely fenced by the
  // packageRule below: `enabled: false` suppresses version bumps but the
  // github-actions manager still SCANS the file and applies its tag->SHA
  // pinDigests, recreating a "Pin dependencies" PR on every scan. ignorePaths
  // stops the scan outright.
  ignorePaths: [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    ".agents/templates/**",
    ".agents/skills/**",
    ".github/workflows/bkit-cloud.yml",
  ],

  // ─────────────────────────────────────────────────────────────────────
  // Private-registry read auth — `@cbartens/bkit` lives on GitHub Packages
  // (npm.pkg.github.com, restricted). Renovate must authenticate to RESOLVE it
  // when regenerating `pnpm-lock.yaml` for ANY dependency bump. Without a token
  // the regen fails, every dependency PR lands with a stale lockfile, and CI
  // then fails `pnpm install --frozen-lockfile` (ERR_PNPM_OUTDATED_LOCKFILE).
  // The GitHub-Actions `GH_BKIT_TOKEN` repo secret used for CI is NOT visible
  // to Mend's hosted runner — the token must be provisioned on Renovate's side.
  // This rule is an inert anchor until you add the token. Full recipe:
  // docs/deployments.md § GitHub Actions pinning (Renovate read-auth).
  // ─────────────────────────────────────────────────────────────────────
  hostRules: [
    {
      matchHost: "npm.pkg.github.com",
      hostType: "npm",
      // Provide a PAT with `read:packages`. Pick ONE path, then this rule
      // authenticates Renovate's lockfile regeneration:
      //   - Mend hosted: add `GH_BKIT_TOKEN` as a Mend repository secret
      //     (https://developer.mend.io/github/<owner>/<repo> → Settings →
      //     Secrets). In the secret dialog you MUST tick "If checked - secret
      //     will be used during the scan as an environment variable." — without
      //     it the secret is never exposed to the scan and regen still 401s.
      //     Then uncomment the next line:
      // token: "{{ secrets.GH_BKIT_TOKEN }}",
      //   - Self-hosted: inject via the `RENOVATE_HOST_RULES` env var or an
      //     `encrypted` block — no edit needed here.
    },
  ],

  // Cap concurrent PRs so a major-version flood doesn't drown the repo.
  prConcurrentLimit: 10,
  prHourlyLimit: 4,

  packageRules: [
    // ─────────────────────────────────────────────────────────────────────
    // bkit-managed workflow files — DO NOT BUMP.
    // bkit ships these via `bkit install`. Consumer-side Renovate must stay
    // out of them; new SHAs/versions arrive when consumers bump the bkit
    // package and re-run `bkit install`. The primary fence is `ignorePaths`
    // above (stops the scan AND the tag->SHA pinning that recreated the "Pin
    // dependencies" PR); this rule is a secondary guard that still suppresses
    // version bumps should the file ever be removed from ignorePaths.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchFileNames: [
        ".github/workflows/bkit-cloud.yml",
      ],
      enabled: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // The bkit package itself — DO NOT BUMP via Renovate.
    // bkit upgrades via `pnpm add -D @cbartens/bkit@latest && pnpm bkit upgrade`,
    // which re-syncs templates, substitutes tokens, and bumps the pin. A bare
    // version bump skips that and leaves the consumer split-brain. The package
    // also lives on GitHub Packages (restricted), which Mend's hosted runner has
    // no token for — so Renovate only ever logs a "no-result" lookup. See #132.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchPackageNames: ["@cbartens/bkit"],
      enabled: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Group all non-major npm bumps into one PR per dependency-type.
    // One coherent PR per week beats one PR per package.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["devDependencies"],
      groupName: "devDependencies (non-major)",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch"],
      matchDepTypes: ["dependencies"],
      groupName: "dependencies (patch)",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor"],
      matchDepTypes: ["dependencies"],
      groupName: "dependencies (minor)",
      // Minor prod bumps: review manually; no auto-merge.
    },

    // Major bumps — always separate, never auto-merged. A human reads the
    // changelog.
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dep-major"],
    },

    // Group related ecosystems so they bump in lockstep (avoids peer-dep churn).
    {
      matchPackagePatterns: ["^@tanstack/"],
      groupName: "tanstack",
    },
    {
      matchPackagePatterns: ["^@types/"],
      groupName: "type definitions",
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchPackagePatterns: ["^eslint", "^@eslint/", "^@typescript-eslint/"],
      groupName: "linters (eslint)",
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchPackagePatterns: ["^vitest", "^@vitest/"],
      groupName: "vitest",
    },
    {
      matchPackagePatterns: ["^@playwright/"],
      groupName: "playwright",
    },

    // ─────────────────────────────────────────────────────────────────────
    // GitHub Actions — refreshes SHA-pinned `uses:` lines on upstream releases
    // and CVE disclosures (pairs with bkit's SHA-pinning rule in
    // docs/deployments.md § GitHub Actions pinning).
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      // Pin to SHA + tag comment; Renovate maintains the tag comment.
      pinDigests: true,
    },
  ],

  // Where to send PRs. `dev` per baseBranches above.
  // Auto-merge config: Renovate uses GitHub's native auto-merge when
  // `platformAutomerge: true` is set (above), which respects branch
  // protection — required checks must pass before auto-merge fires.
}
