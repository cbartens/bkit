# .envrc — direnv config shipped by bkit.
# Example. Copy into the repo and own it.
# bkit install does not write this file and does not overwrite a copy.
#
# Append more `dotenv_if_exists <path>` lines to expose additional env files
# (e.g. .env.local, infra/secrets.env). After editing, run `direnv allow`.
dotenv_if_exists .bkit/.env

# graphify output folder, so a bare `graphify` call writes where scripts/graphify/bkit-graphify.sh does.
export GRAPHIFY_OUT=docs/graphify-out

# Keep the Anthropic API key out of the global shell. Avoids claude.ai subscription conflict.
unset ANTHROPIC_API_KEY
