{
  "name": "@cbartens/bkit",
  "version": "5.4.0",
  "private": false,
  "description": "From vibe coding to production code. A senior engineering team's process, ready-made: AI agents design, plan, build, review, fix and ship your features on Claude Code, Cursor, Codex, Google Antigravity and opencode.",
  "keywords": [
    "ai-agents",
    "agentic-coding",
    "agentic-workflow",
    "multi-agent",
    "vibe-coding",
    "claude-code",
    "cursor",
    "codex",
    "antigravity",
    "gemini",
    "opencode",
    "ai-code-review",
    "code-review",
    "developer-tools",
    "workflow-automation",
    "ci-cd",
    "github-actions",
    "linear",
    "llm",
    "cli"
  ],
  "homepage": "https://github.com/cbartens/bkit#readme",
  "bugs": "https://github.com/cbartens/bkit/issues",
  "type": "module",
  "bin": {
    "bkit": "./dist/cli.js"
  },
  "files": [
    ".bkit/core",
    ".bkit/shared",
    ".bkit/templates",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbartens/bkit.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "bkit:gate:format": "pnpm lint-staged",
    "bkit:gate:static": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm format:tables:check && pnpm lint:prose && pnpm slop:delta",
    "bkit:gate:static-unit": "pnpm bkit:gate:static && pnpm test && pnpm test:coverage:unit && pnpm bkit:test:bats",
    "bkit:gate:install-static-unit-build": "pnpm install --frozen-lockfile && pnpm bkit:gate:static-unit && pnpm build",
    "bkit:deps:outdated": "pnpm outdated",
    "bkit:deps:audit": "pnpm audit",
    "bkit:test:file": "vitest run --reporter=default --reporter=junit --outputFile.junit=\"$BKIT_TEST_REPORT\"",
    "bkit": "node dist/cli.js",
    "typecheck": "tsc --noEmit && pnpm bkit:typecheck:tests",
    "bkit:typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "oxlint -c .oxlintrc.json --type-aware --tsconfig tsconfig.test.json --deny-warnings .bkit/core/engine",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:tables": "node scripts/prettier/bkit-insert-ignore.mjs .agents docs README.md .bkit/shared .bkit/core/.agents .bkit/core/docs",
    "format:tables:check": "node scripts/prettier/bkit-insert-ignore.mjs --check .agents docs README.md .bkit/shared .bkit/core/.agents .bkit/core/docs",
    "lint:prose": "bkit ci prose --glob='.agents/*.md' --glob='.bkit/core/.bkit/*.md' --glob='.bkit/core/workflows/**/*.md' --glob='.bkit/core/prompts/**/*.md' --glob='.bkit/core/.agents/*.md' --glob='.bkit/shared/docs/**/*.md' --glob='.bkit/core/docs/**/*.md' --glob='.bkit/templates/**/*.md' --glob='docs/*.md' --glob='*.md'",
    "lint:slop": "slop-scan scan .",
    "slop:delta": "bkit ci slop",
    "bkit:lint:workflows": "bash -c 'if command -v actionlint >/dev/null 2>&1; then actionlint; else echo \"[bkit] actionlint missing — skipping workflow lint (install actionlint to enable)\"; fi'",
    "test": "vitest run",
    "test:coverage:unit": "vitest run -c vitest.unit.config.ts --coverage --coverage.reportsDirectory=coverage/unit --exclude '**/*.integration.test.ts' --coverage.include='.bkit/core/engine/{cli,commands/analysis,install/cloud-env,commands/comply,commands/harvest,commands/install/install,commands/launch,install/manifest,install/managed-block,shared/package-roots,shared/protected-paths,checks/after/index,checks/after/auth,checks/after/ci-yml,checks/after/github,checks/after/managed,checks/after/tools,checks/after/suppression,checks/before/index,checks/before/context-fetch,checks/before/env,checks/before/files,checks/before/mcp,checks/before/repo,checks/before/version,ledgers/status,ledgers/telemetry,install/write,install/placeholders,install/template-copies,render/trackers,render/hosts,render/models,commands/install/uninstall,commands/install/upgrade,install/version-file,tools/wording}.ts' --coverage.include='.bkit/core/engine/commands/**/*.ts' --coverage.include='.bkit/core/engine/shared/{settings,package-json,package-manager,timeouts}.ts'",
    "bkit:test:bats": "pnpm exec bats tests/*.bats",
    "build": "tsc && chmod +x dist/cli.js",
    "bkit:check:dist": "rm -rf dist && tsc && chmod +x dist/cli.js && git diff --exit-code dist/ || (echo '[bkit] dist/ is stale — run pnpm build and commit the result' && exit 1)",
    "graph": "bash scripts/graphify/bkit-graphify.sh build",
    "graph:check": "bash scripts/graphify/bkit-graphify.sh check",
    "graph:clean": "bash scripts/graphify/bkit-graphify.sh clean",
    "graph:graphml": "bash scripts/graphify/bkit-graphify.sh graphml",
    "graph:refresh": "bash scripts/graphify/bkit-graphify.sh refresh",
    "graph:rollup": "bash scripts/graphify/bkit-graphify.sh rollup",
    "graph:scoped": "bash scripts/graphify/bkit-graphify.sh scoped",
    "graph:tree": "bash scripts/graphify/bkit-graphify.sh tree",
    "graph:update": "bash scripts/graphify/bkit-graphify.sh update",
    "bkit:audit:status": "tsx .bkit/core/engine/checks/status-holes.ts docs/plans/*/logs/*/status.jsonl",
    "wording:sync": "tsx .bkit/core/engine/tools/wording.ts --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "bats": "1.13.0",
    "bkit": "link:.",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "slop-scan": "0.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.2",
      "esbuild": "^0.28.0"
    }
  },
  "bkit": {
    "issueTracker": "github",
    "cloudAgents": "claude",
    "githubProject": false,
    "opencodeProvider": "openrouter",
    "opencodeProviders": [
      "opencode-go",
      "openrouter"
    ],
    "capstoneJob": "bkit-tests-check",
    "ciWorkflow": "bkit-ci.yml",
    "roadmapNext": 25
  }
}
