{
  "name": "@bartens/bkit",
  "version": "0.1.0-pre.1",
  "description": "Agent-stack consolidation CLI — install/upgrade .agents/ payload across Claude and Cursor hosts",
  "type": "module",
  "bin": { "bkit": "./dist/bkit-install.js" },
  "files": [
    "dist",
    ".agents",
    "README.md"
  ],
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbartens/bkit.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": { "access": "public" }
}
