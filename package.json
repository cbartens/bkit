{
  "name": "@cbartens/bkit",
  "version": "0.1.1",
  "private": true,
  "description": "Agent-stack consolidation CLI — installed as a git dependency from a private GitHub repo (no npm registry).",
  "type": "module",
  "bin": { "bkit": "./dist/bkit-install.js" },
  "files": [
    "dist",
    ".agents",
    "README.md"
  ],
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbartens/bkit.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
