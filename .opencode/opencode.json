{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "rules": [
      {
        "description": "Allow reading any file",
        "tools": ["Read"],
        "mode": "allow"
      },
      {
        "description": "Allow writing files (agents write output artifacts)",
        "tools": ["Write", "Edit"],
        "mode": "allow"
      },
      {
        "description": "Allow grep and glob for code navigation",
        "tools": ["Grep", "Glob"],
        "mode": "allow"
      },
      {
        "description": "Allow bash execution (gated by gateguard plugin)",
        "tools": ["Bash"],
        "mode": "allow"
      },
      {
        "description": "Allow task dispatch (orchestrator spawns subagents)",
        "tools": ["Task"],
        "mode": "allow"
      },
      {
        "description": "Ask before sudo commands",
        "tools": ["Bash(sudo:*)"],
        "mode": "ask"
      },
      {
        "description": "Ask before curl/wget network ops",
        "tools": ["Bash(curl:*)", "Bash(wget:*)"],
        "mode": "ask"
      },
      {
        "description": "Deny destructive git force-push",
        "tools": ["Bash(git push --force:*)", "Bash(git push -f:*)"],
        "mode": "deny"
      },
      {
        "description": "Allow --force-with-lease (Step 2 rebase companion on personal feat/fix branches). Placed AFTER the force deny so last-match-wins permits it even if the glob matcher treats --force as a prefix; bare --force / -f stay denied above.",
        "tools": ["Bash(git push --force-with-lease:*)"],
        "mode": "allow"
      },
      {
        "description": "Deny rm -rf on root or home",
        "tools": ["Bash(rm -rf /*)", "Bash(rm -rf ~/*)", "Bash(rm -rf $HOME/*)"],
        "mode": "deny"
      }
    ]
  },
  "mcp": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}",
        "X-MCP-Toolsets": "context,issues,pull_requests,repos,users,projects"
      }
    }
  },
  "plugins": [".opencode/plugin/gateguard.js"],
  "provider": {
    "nvidia": {
      "api": "openai",
      "options": {
        "apiKey": "${NVIDIA_API_KEY}",
        "baseURL": "https://integrate.api.nvidia.com/v1"
      }
    }
  }
}
