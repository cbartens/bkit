  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:BKIT_GH_TOKEN}",
        "X-MCP-Toolsets": "context,issues,pull_requests,repos,users,projects,actions"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ]
    }
  },
  "plugin": [
    "./plugin/bkit-gateguard.js",
    "./plugin/bkit-readguard.js"
  ],
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:BKIT_OPENROUTER_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:BKIT_OPENCODE_API_KEY}"
      }
    }
