{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.p12": "deny",
      "*id_rsa": "deny"
    },
    "edit": "allow",
    "grep": "allow",
    "glob": "allow",
    "task": "allow",
    "websearch": "allow",
    "webfetch": {
      "*": "ask",
      "*12factor.net*": "allow",
      "*agents.md*": "allow",
      "*agentskills.io*": "allow",
      "*anthropic.com*": "allow",
      "*artificialanalysis.ai*": "allow",
      "*atlassian.com*": "allow",
      "*c4model.com*": "allow",
      "*cabforum.org*": "allow",
      "*chatgpt.com*": "allow",
      "*claude.com*": "allow",
      "*commonmark.org*": "allow",
      "*cursor.com*": "allow",
      "*datacurve.ai*": "allow",
      "*depot.dev*": "allow",
      "*designarena.ai*": "allow",
      "*diataxis.fr*": "allow",
      "*direnv.net*": "allow",
      "*docker.com*": "allow",
      "*docker.io*": "allow",
      "*dora.dev*": "allow",
      "*endoflife.date*": "allow",
      "*etsi.org*": "allow",
      "*europa.eu*": "allow",
      "*finops.org*": "allow",
      "*git-scm.com*": "allow",
      "*github.com*": "allow",
      "*github.io*": "allow",
      "*githubcopilot.com*": "allow",
      "*githubusercontent.com*": "allow",
      "*gnu.org*": "allow",
      "*google.dev*": "allow",
      "*ico.org.uk*": "allow",
      "*ietf.org*": "allow",
      "*iso.org*": "allow",
      "*jqlang.org*": "allow",
      "*json-schema.org*": "allow",
      "*kanbanguides.org*": "allow",
      "*linear.app*": "allow",
      "*livebench.ai*": "allow",
      "*lmarena.ai*": "allow",
      "*mend.io*": "allow",
      "*mitre.org*": "allow",
      "*modelcontextprotocol.io*": "allow",
      "*models.dev*": "allow",
      "*mozilla.org*": "allow",
      "*nist.gov*": "allow",
      "*nngroup.com*": "allow",
      "*nodejs.org*": "allow",
      "*nodesource.com*": "allow",
      "*npmjs.com*": "allow",
      "*npmjs.org*": "allow",
      "*ollama.com*": "allow",
      "*openai.com*": "allow",
      "*opencode.ai*": "allow",
      "*opengroup.org*": "allow",
      "*openrouter.ai*": "allow",
      "*openssf.org*": "allow",
      "*opentelemetry.io*": "allow",
      "*owasp.org*": "allow",
      "*pnpm.io*": "allow",
      "*prettier.io*": "allow",
      "*publicsuffix.org*": "allow",
      "*renovatebot.com*": "allow",
      "*rfc-editor.org*": "allow",
      "*schema.org*": "allow",
      "*schemastore.org*": "allow",
      "*scrumguides.org*": "allow",
      "*semver.org*": "allow",
      "*shellcheck.net*": "allow",
      "*skills.sh*": "allow",
      "*slsa.dev*": "allow",
      "*spdx.org*": "allow",
      "*sre.google*": "allow",
      "*tavily.com*": "allow",
      "*tc39.es*": "allow",
      "*typescriptlang.org*": "allow",
      "*vale.sh*": "allow",
      "*vite.dev*": "allow",
      "*vitest.dev*": "allow",
      "*w3.org*": "allow",
      "*yaml.org*": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "brew install*": "ask",
      "pnpm publish*": "ask",
      "npm publish*": "ask",
      "bun publish*": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "git clean -fdx*": "ask",
      "git filter-branch*": "ask",
      "git checkout -- .*": "ask",
      "git restore .*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git rebase -i*": "ask",
      "gh repo delete*": "ask",
      "gh pr close*": "ask",
      "gh release delete*": "ask",
      "git reset *--hard*": "ask",
      "git -* reset *--hard*": "ask",
      "git clean -*f*": "ask",
      "git checkout *.": "ask",
      "git checkout * . *": "ask",
      "git restore *.": "ask",
      "git restore * . *": "ask",
      "git rebase * -i": "ask",
      "git rebase * -i *": "ask",
      "git rebase *--interactive*": "ask",
      "chmod -R 777 /*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME/*": "deny",
      "rm -rf ~": "deny",
      "rm -rf $HOME": "deny",
      "rm -rf ${HOME}": "deny",
      "rm -rf ${HOME}/*": "deny",
      "rm -fr /*": "deny",
      "rm -fr ~": "deny",
      "rm -fr ~/*": "deny",
      "rm -fr $HOME": "deny",
      "rm -fr $HOME/*": "deny",
      "rm -fr ${HOME}": "deny",
      "rm -fr ${HOME}/*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "allow",
      "git * --no-verify": "ask",
      "git * --no-verify *": "ask",
      "git commit -n*": "ask",
      "git commit * -n": "ask",
      "git commit * -n *": "ask",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push * --force": "deny",
      "git push * --force *": "deny",
      "git push * -f*": "deny",
      "git push * +*": "deny",
      "git -* push* --force": "deny",
      "git -* push* --force *": "deny",
      "git -* push* -f*": "deny",
      "git -* push* +*": "deny",
      "git push* -uf*": "deny",
      "git -* push* -uf*": "deny",
      "git push* -vf*": "deny",
      "git -* push* -vf*": "deny",
      "git push* -qf*": "deny",
      "git -* push* -qf*": "deny",
      "git push* -nf*": "deny",
      "git -* push* -nf*": "deny",
      "git push* -df*": "deny",
      "git -* push* -df*": "deny",
      "git push* -4f*": "deny",
      "git -* push* -4f*": "deny",
      "git push* -6f*": "deny",
      "git -* push* -6f*": "deny",
      "*bkit*tests jump*": "ask",
      "*cli.js tests jump*": "ask",
      "*cli.ts tests jump*": "ask"
    },
    "github_*": "allow",
    "serena_*": "allow"
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:BKIT_GH_TOKEN}",
        "X-MCP-Toolsets": "context,issues,pull_requests,repos,users,projects,actions"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ]
    }
  },
  "plugin": [
    "./plugin/bkit-gateguard.js",
    "./plugin/bkit-readguard.js",
    "./plugin/bkit-rules.js",
    "./plugin/bkit-guardrails.js"
  ],
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:BKIT_OPENROUTER_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:BKIT_OPENCODE_API_KEY}"
      }
    }
  }
}
