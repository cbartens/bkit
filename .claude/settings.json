      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:*.npmjs.com)",
      "Bash(git push --force-with-lease:*)",
      "Read(./.env.example)",
      "Read(./**/.env.example)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:githubusercontent.com)",
      "WebFetch(domain:linear.app)",
      "WebFetch(domain:ollama.com)",
      "WebFetch(domain:opencode.ai)",
      "WebFetch(domain:openrouter.ai)",
      "WebFetch(domain:tavily.com)",
      "WebFetch(domain:*.tavily.com)",
      "WebFetch(domain:githubcopilot.com)",
      "WebFetch(domain:*.githubcopilot.com)",
      "WebFetch(domain:models.dev)",
      "WebFetch(domain:*.models.dev)",
      "WebFetch(domain:npmjs.org)",
      "WebFetch(domain:*.npmjs.org)",
      "WebFetch(domain:skills.sh)",
      "WebFetch(domain:*.skills.sh)",
      "WebFetch(domain:agents.md)",
      "WebFetch(domain:*.agents.md)",
      "WebFetch(domain:agentskills.io)",
      "WebFetch(domain:*.agentskills.io)",
      "WebFetch(domain:artificialanalysis.ai)",
      "WebFetch(domain:*.artificialanalysis.ai)",
      "WebFetch(domain:chatgpt.com)",
      "WebFetch(domain:*.chatgpt.com)",
      "WebFetch(domain:commonmark.org)",
      "WebFetch(domain:*.commonmark.org)",
      "WebFetch(domain:depot.dev)",
      "WebFetch(domain:*.depot.dev)",
      "WebFetch(domain:designarena.ai)",
      "WebFetch(domain:*.designarena.ai)",
      "WebFetch(domain:direnv.net)",
      "WebFetch(domain:*.direnv.net)",
      "WebFetch(domain:docker.com)",
      "WebFetch(domain:*.docker.com)",
      "WebFetch(domain:docker.io)",
      "WebFetch(domain:*.docker.io)",
      "WebFetch(domain:git-scm.com)",
      "WebFetch(domain:*.git-scm.com)",
      "WebFetch(domain:github.io)",
      "WebFetch(domain:*.github.io)",
      "WebFetch(domain:gnu.org)",
      "WebFetch(domain:*.gnu.org)",
      "WebFetch(domain:ietf.org)",
      "WebFetch(domain:*.ietf.org)",
      "WebFetch(domain:jqlang.org)",
      "WebFetch(domain:*.jqlang.org)",
      "WebFetch(domain:json-schema.org)",
      "WebFetch(domain:*.json-schema.org)",
      "WebFetch(domain:livebench.ai)",
      "WebFetch(domain:*.livebench.ai)",
      "WebFetch(domain:lmarena.ai)",
      "WebFetch(domain:*.lmarena.ai)",
      "WebFetch(domain:mend.io)",
      "WebFetch(domain:*.mend.io)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:*.modelcontextprotocol.io)",
      "WebFetch(domain:mozilla.org)",
      "WebFetch(domain:*.mozilla.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:*.nodejs.org)",
      "WebFetch(domain:nodesource.com)",
      "WebFetch(domain:*.nodesource.com)",
      "WebFetch(domain:openai.com)",
      "WebFetch(domain:*.openai.com)",
      "WebFetch(domain:opengroup.org)",
      "WebFetch(domain:*.opengroup.org)",
      "WebFetch(domain:owasp.org)",
      "WebFetch(domain:*.owasp.org)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:*.pnpm.io)",
      "WebFetch(domain:prettier.io)",
      "WebFetch(domain:*.prettier.io)",
      "WebFetch(domain:publicsuffix.org)",
      "WebFetch(domain:*.publicsuffix.org)",
      "WebFetch(domain:renovatebot.com)",
      "WebFetch(domain:*.renovatebot.com)",
      "WebFetch(domain:rfc-editor.org)",
      "WebFetch(domain:*.rfc-editor.org)",
      "WebFetch(domain:schemastore.org)",
      "WebFetch(domain:*.schemastore.org)",
      "WebFetch(domain:semver.org)",
      "WebFetch(domain:*.semver.org)",
      "WebFetch(domain:shellcheck.net)",
      "WebFetch(domain:*.shellcheck.net)",
      "WebFetch(domain:tc39.es)",
      "WebFetch(domain:*.tc39.es)",
      "WebFetch(domain:typescriptlang.org)",
      "WebFetch(domain:*.typescriptlang.org)",
      "WebFetch(domain:vale.sh)",
      "WebFetch(domain:*.vale.sh)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:*.vite.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:*.vitest.dev)",
      "WebFetch(domain:yaml.org)",
      "WebFetch(domain:*.yaml.org)",
      "mcp__claude_ai_github__*"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME/*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(brew install:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(bun publish:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git restore .:*)",
      "Bash(git stash drop:*)",
      "Bash(git rebase -i:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh pr close:*)",
      "Bash(gh release delete:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.bkit/.env)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/preflight.sh"
          },
          {
            "type": "command",
            "command": "test -f .claude/hooks/cloud-bootstrap.sh && bash .claude/hooks/cloud-bootstrap.sh || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .claude/hooks/gateguard.cjs && node .claude/hooks/gateguard.cjs || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .claude/hooks/guardrails.cjs && node .claude/hooks/guardrails.cjs || true"
          }
        ]
      }
    ]
  }
}
