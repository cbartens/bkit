# Dependencies
node_modules/
.pnpm-store/

# Build outputs
build/
.cache/

# dist/ is tracked — bkit ships pre-built so git-dep consumers skip `prepare: tsc`.
# CI verifies freshness on every push. Generated at install/build in worktrees only — never gitignored.
*.tsbuildinfo
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets (force-allow .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Tmp / pack artifacts
tmp/**
*.tgz

# Vale downloaded packages (write-good, etc.) — not checked in; CI runs vale sync
.vale/styles/write-good

# Serena (only project.yml is tracked) and graphify raw output (only docs/capabilities.md is tracked)
.serena/*
!.serena/project.yml
graphify-out/

# <!-- bkit:start -->

# <!-- bkit:managed v6.0.0 — do not edit; run `bkit upgrade` to refresh -->

# Worktrees, plan logs, per-run sentinels. Sentinels are written mid-run, read by
# the same run's Failure Path, cleared at next Step 1 — never bookkeeping, so
# path-scoped staging must not commit them.
.worktrees/
docs/plans/*/logs/**/raw/
docs/plans/*/logs/**/.lock
# Per-run sentinels sit in BOOK_PATHS-staged logs — without these lines a Failure
# Path commit captures them and the next `rm -f` shows as a tracked deletion.
docs/plans/*/logs/**/.deferred-blocked
docs/plans/*/logs/**/.rebase-failed

# Cursor background-agent runtime marker
.bkit/.runtime-cursor

.bkit/.roadmap-shortlist.json
.bkit/.roadmap-reverse-sync.json

# Claude Code /schedule daemon lock
.claude/scheduled_tasks.lock

# Cloud setup docs — `bkit install` inlines resolved .envrc secrets; never commit.
# One per host: .claude/bkit-cloud.md (Claude Code web), .cursor/bkit-cloud.md (Cursor Cloud Agents), .codex/bkit-cloud.md (Codex Cloud)
.claude/bkit-cloud.md
.cursor/bkit-cloud.md
.codex/bkit-cloud.md

# Claude native worktrees (isolation:worktree / EnterWorktree) — transient full-tree
# copies; ignore or slop:delta double-counts the checkout
.claude/worktrees/

# cursor / opencode — no project-local worktree or runtime dir to ignore.
# Cursor agents run in remote VMs; opencode state lives at ~/.local/share/opencode
# (XDG_DATA_HOME). bkit-managed files in .opencode/ are tracked.

# husky 9 stub (auto-generated by `husky` from prepare)
.husky/_

# Coverage (vitest --coverage) — regenerated each run, never commit
coverage/

# Playwright artifacts — grow under [verbose ci]
test-results/
playwright-report/
blob-report/
.last-run.json
playwright/.auth/

# Advisories — regenerated by `bkit install` / `check` / `doctor`
.bkit/advisories.md

# Local MCP / agent secrets — never commit
.bkit/.env

# Payload view links — `bkit install` / `upgrade` symlink these into
# node_modules/@cbartens/bkit; they dangle on a fresh clone or in CI, so never commit.
.bkit/core
.bkit/shared

# <!-- bkit:end -->

# Dogfood negations: `.bkit/core` + `.bkit/shared` are this repo's install SOURCE
# (tracked). The managed block's consumer link-ignore above must never hide new
# source files here — bkit the consumer's view links do not exist in bkit's own repo.
!.bkit/core
!.bkit/shared

# Python bytecode. Python helpers under scripts/ regenerate this on import.
__pycache__/
*.pyc

# Secrets sync: fingerprint + time of each push.
scripts/secrets/bkit-secrets-state.json

# Harvest store + consumer list (`pnpm harvest`): private repo content and local paths.
# Local only and not backed up by bkit; the store is the sole copy of pruned rows.
harvest/
