# Dependencies
node_modules/
.pnpm-store/

# Build outputs
build/
.cache/

# Note: dist/ is INTENTIONALLY tracked (since v0.3.0). bkit ships pre-built
# so consumers installing the git-dep don't need to run `prepare: tsc`,
# avoiding lifecycle-hook recursion in monorepo workspaces (BAR-130 #5).
# CI verifies dist/ is fresh on every push. Generated at install/build
# time only in development worktrees — never gitignored.
*.tsbuildinfo
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets (force-allow .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Tmp / pack artifacts
tmp/**
*.tgz

# Vale downloaded packages (write-good, etc.) — not checked in; CI runs vale sync
.vale/styles/write-good

# <!-- bkit:start -->

# bkit workflows — worktrees, plan logs, and run-scoped routing sentinels.
# The sentinels (.deferred-blocked, .rebase-failed) are written mid-run, read
# by the same run's Failure Path, and cleared by the next run's Step 1: never
# bookkeeping, so path-scoped staging must not carry them into a commit.
.worktrees/
docs/plans/*/logs/**/raw/
docs/plans/*/logs/**/.lock
# Transient per-run workflow sentinels — written mid-run and cleared at the next
# workflow start. They sit inside the BOOK_PATHS-staged logs dir, so without
# these lines a Failure Path commit captures them and the next run's `rm -f`
# then shows up as a spurious tracked deletion.
docs/plans/*/logs/**/.deferred-blocked
docs/plans/*/logs/**/.rebase-failed

# bkit workflows — repo-global dev critical-section lock (cross-FID)
.bkit/.dev.lock
.bkit/.runtime-cursor

# bkit workflows — #380 per-FID tracker-enrichment scratch file (never committed)
.bkit/.roadmap-tracker-rows-*.json
.bkit/.roadmap-reverse-sync-*.json
.bkit/.roadmap-refresh-on-demand.md

# Claude Code harness — /schedule daemon lock
.claude/scheduled_tasks.lock

# Cloud setup docs — generated by `bkit install`, inline resolved secrets from
# .envrc; regenerated each install, never commit. One per cloud host:
# .claude/cloud.md (Claude Code on the web), .cursor/cloud.md (Cursor Background Agents)
.claude/cloud.md
.cursor/cloud.md

# Claude Code harness — native worktree isolation (Agent isolation:worktree /
# EnterWorktree) checks out a full-tree copy here; transient, never commit —
# otherwise slop:delta double-counts the whole checked-out source tree
.claude/worktrees/

# cursor / opencode — no project-local worktree dir to ignore: cursor background
# agents run in remote VMs, and opencode runtime state is stored globally at
# ~/.local/share/opencode (XDG_DATA_HOME), not the project .opencode/ dir
# (confirmed by spike-verdict.md §(e): `opencode debug paths`). bkit-managed
# files in .opencode/ are tracked; no project-local runtime entries to ignore.

# husky 9 stub directory (auto-generated by `husky` from prepare script)
.husky/_

# Coverage reports (vitest --coverage) — regenerated each run, never committed
coverage/

# Playwright test artifacts — especially grow under [verbose ci]
test-results/
playwright-report/
blob-report/
.last-run.json
playwright/.auth/

# bkit advisories artifact — regenerated by every `bkit install` / `check` / `doctor`
.bkit/advisories.md

# local secrets for MCP servers / agent tooling — never commit
.bkit/.env

# <!-- bkit:end -->

# Internal
.bkit/consumers.md
