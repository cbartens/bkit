# Dependencies
node_modules/
.pnpm-store/

# Build outputs
build/
.cache/

# Note: dist/ is INTENTIONALLY tracked (since v0.3.0). bkit ships pre-built
# so consumers installing the git-dep don't need to run `prepare: tsc`,
# avoiding lifecycle-hook recursion in monorepo workspaces (BAR-130 #5).
# CI verifies dist/ is fresh on every push. Generated at install/build
# time only in development worktrees — never gitignored.
*.tsbuildinfo
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets (force-allow .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Tmp / pack artifacts
tmp/**
*.tgz

# Vale downloaded packages (write-good, etc.) — not checked in; CI runs vale sync
.vale/styles/write-good

# <!-- bkit:start -->

# bkit workflows
.worktrees/
docs/plans/logs/**/raw/
docs/plans/logs/**/.lock

# bkit runtime artifact (written by installer, never SoT)
.agents/.bkit-version

# husky 9 stub directory (auto-generated by `husky install` from prepare script)
.husky/_

# <!-- bkit:end -->
