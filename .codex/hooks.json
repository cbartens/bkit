{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codex/hooks/bkit-gateguard.cjs && node .codex/hooks/bkit-gateguard.cjs || true",
            "statusMessage": "bkit GateGuard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codex/hooks/bkit-guardrails.cjs && node .codex/hooks/bkit-guardrails.cjs || true",
            "statusMessage": "bkit guardrails"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codex/hooks/bkit-readguard.cjs && node .codex/hooks/bkit-readguard.cjs || true",
            "statusMessage": "bkit ReadGuard"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codex/hooks/bkit-rules.cjs && node .codex/hooks/bkit-rules.cjs || true",
            "statusMessage": "bkit rules"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codex/hooks/bkit-rules.cjs && node .codex/hooks/bkit-rules.cjs || true",
            "statusMessage": "bkit rules"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f .codex/hooks/bkit-readguard.cjs && node .codex/hooks/bkit-readguard.cjs || true",
            "statusMessage": "bkit ReadGuard"
          }
        ]
      }
    ]
  }
}
