exports[`C6 — consumer CI router template (.agents/templates/.github/workflows/bkit-ci-router.yml) > snapshot matches expected router template content (regression guard) 1`] = `
"name: bkit-ci-router
on:
  workflow_run:
    workflows: [CI]
    types: [completed]
    branches: [feat/**]
permissions:
  contents: read
  pull-requests: write
  issues: write
  actions: read
concurrency:
  group: bkit-ci-router-\${{ github.event.workflow_run.head_branch }}
  cancel-in-progress: true
jobs:
  route:
    if: \${{ github.event.workflow_run.conclusion == 'success' || github.event.workflow_run.conclusion == 'failure' }}
    runs-on: ubuntu-latest
    timeout-minutes: 210 # formula: MAX_DEBUG_ATTEMPT (3) × per-attempt ceiling (60min) + 30min margin (checkout/setup/Claude warmup); strictly < runner 6h cap (360); upper assertion in bkit-action-yaml.test.ts is ≤ 240.
    steps:
      - uses: actions/checkout@v4
        with:
          ref: \${{ github.event.workflow_run.head_sha }}
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
      - uses: pnpm/action-setup@v4
      - uses: cbartens/bkit/.github/actions/setup-auth@v1
        with:
          token: \${{ secrets.GH_BKIT_TOKEN }}
      - run: pnpm install --frozen-lockfile
        env:
          GH_BKIT_TOKEN: \${{ secrets.GH_BKIT_TOKEN }}
      - uses: anthropics/claude-code-action@v1
        env:
          ANTHROPIC_API_KEY: \${{ secrets.ANTHROPIC_API_KEY }}
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          CI_RUN_CONCLUSION: \${{ github.event.workflow_run.conclusion }}
          CI_RUN_HEAD_SHA: \${{ github.event.workflow_run.head_sha }}
          CI_RUN_HEAD_BRANCH: \${{ github.event.workflow_run.head_branch }}
          CI_RUN_URL: \${{ github.event.workflow_run.html_url }}
        with:
          anthropic_api_key: \${{ secrets.ANTHROPIC_API_KEY }}
          prompt: "/bkit-ci-router"
          claude_args: "--allowed-tools=Bash,Edit,Write,Read,Grep,Glob,WebFetch,Skill,mcp__linear__*"
"
`;

exports[`consumer CI template (.agents/templates/.github/workflows/ci.yml) > snapshot matches expected template content (regression guard) 1`] = `
"name: CI

on:
  workflow_dispatch:
  push:
    branches: [{{DEFAULT_BRANCH}}, dev]
  pull_request:
    branches: [{{DEFAULT_BRANCH}}, dev]

permissions:
  actions: read
  contents: read

jobs:
  run-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: {{NODE_VERSION}}

      # Pnpm version is resolved from the consumer's package.json#packageManager (single SoT).
      # Do NOT add \`with: version:\` here — pnpm/action-setup@v4 errors when both are set.
      - uses: pnpm/action-setup@v4

      # bkit:start
      - name: Check SHA Cache
        # Skip the suite when this SHA already has a successful run for this
        # workflow within the last 7 days. Helps after a rollback force-push
        # that points the default branch at a previously-green SHA — avoids
        # re-running 10–20 minutes of tests on known-good code.
        id: cache
        env:
          GH_TOKEN: \${{ github.token }}
        run: |
          SINCE=$(date -u -d '7 days ago' +%FT%TZ 2>/dev/null || date -u -v -7d +%FT%TZ)
          PRIOR=$(gh run list \\
            --repo "$GITHUB_REPOSITORY" \\
            --workflow "$GITHUB_WORKFLOW" \\
            --status success \\
            --limit 50 \\
            --json headSha,createdAt \\
            --jq "[.[] | select(.headSha == \\"$GITHUB_SHA\\") | select(.createdAt > \\"$SINCE\\")] | length" \\
            2>/dev/null || echo 0)
          if [ "\${PRIOR:-0}" -gt 0 ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "::notice::SHA $GITHUB_SHA has $PRIOR prior green run(s) since $SINCE — skipping suite."
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Install Dependencies
        if: steps.cache.outputs.skip != 'true'
        # \`.npmrc\` references \${GH_BKIT_TOKEN} for the @cbartens scope (npm.pkg.github.com).
        # Passing the secret as env is sufficient — no separate auth action is needed.
        # cbartens/bkit is private and cross-org for any consumer outside cbartens/, so a
        # \`uses: cbartens/bkit/...@<ref>\` reference cannot be resolved by the runner's
        # GITHUB_TOKEN at action-resolution time. See README §"Consumer CI auth".
        run: pnpm install --frozen-lockfile
        env:
          GH_BKIT_TOKEN: \${{ secrets.GH_BKIT_TOKEN }}

      - name: Run Typecheck
        if: steps.cache.outputs.skip != 'true'
        run: pnpm typecheck

      - name: Run Vitest Tests
        if: steps.cache.outputs.skip != 'true'
        run: pnpm test

      - name: Run Prettier Format Check
        if: steps.cache.outputs.skip != 'true'
        run: pnpm format:check

      - name: Run Vale Prose Lint
        if: steps.cache.outputs.skip != 'true'
        run: pnpm lint:prose

      - name: Run Slop Scan
        if: steps.cache.outputs.skip != 'true'
        run: pnpm lint:slop

      - name: Run Bkit Check
        if: steps.cache.outputs.skip != 'true'
        run: pnpm bkit check
      # bkit:end
"
`;
