// Example Renovate config. Copy it to `.github/renovate.json5` and own it.
// bkit install does not write this file and does not overwrite a copy.
//
// Reference: https://docs.renovatebot.com/configuration-options/
//
// Mend App install is one-click via GitHub UI (https://github.com/apps/renovate).
// No `gh api` equivalent exists. Land this file on the default branch before
// installing the App. Self-hosted runner: copy
// `.bkit/templates/.github/workflows/bkit-renovate.yml` as well, and suspend the
// Mend App for this repo so both do not open the same PRs.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // `config:best-practices` is Renovate's curated baseline: `config:recommended` plus
  // digest pinning for Docker images and GitHub Actions, exact-version pinning of
  // devDependencies, config-migration PRs, an abandoned-packages section on the
  // dashboard, and a 3-day npm release-age gate (raised to 7 days in the first
  // packageRule below). Repo-specific rules go in this file.
  // A `local>` preset with no `#` is read from the default branch. `useBaseBranchConfig`
  // does not change that fetch. Append the branch `baseBranchPatterns` names — a branch
  // after `#` works (branch, tag, or commit SHA):
  //   "local>owner/repo//path/to/preset.json5#dev"
  // The `extends` line itself is still read from the default branch, so `#dev` needs
  // one merge there before edits on `dev` apply.
  extends: [
    "config:best-practices",
    ":dependencyDashboard",
  ],

  // Renovate opens PRs against `dev`, not the default branch. `main` accepts
  // PRs from `dev` only.
  baseBranchPatterns: ["dev"],

  // Renovate reads its config from the default branch (`main`). `merge` layers
  // `dev`'s config over `main`'s for dev-targeted runs, so config edits on `dev`
  // apply to them. This option is itself read from `main`, so it needs one merge
  // to `main` before dev-side config edits apply.
  // The merge appends list options (`customManagers`, `packageRules`) instead of
  // replacing them: each custom manager runs twice, so the dashboard lists its
  // files twice and the run logs "Cannot find replaceString" for the second pass.
  // PRs still open once. A rule deleted on `dev` keeps applying until `main` drops it.
  // See docs/deployments.md § Dependency updaters.
  useBaseBranchConfig: "merge",

  // Weekly batched runs: every hour of Monday (UTC). The daily bkit-renovate.yml cron
  // can start hours after its set time, so a window of a few hours would miss it.
  // CVE-driven updates are not held to this schedule (`osvVulnerabilityAlerts` below).
  schedule: ["* * * * 1"],
  timezone: "UTC",

  // CVE alerts → Renovate opens a PR immediately, outside the weekly schedule.
  // These PRs target `dev` (baseBranchPatterns above).
  osvVulnerabilityAlerts: true,

  // Conventional-commit prefix.
  commitMessagePrefix: "chore(deps):",

  // ─────────────────────────────────────────────────────────────────────
  // pnpm 11 release-age freshness + Renovate-runner memory ceiling.
  //
  // `env` caps pnpm's worker pool at 1 in Renovate's runner only; CI, Vercel
  // and local installs are untouched. PNPM_WORKERS / PNPM_MAX_WORKERS are on
  // Mend's `global:safeEnv` allow-list, so no admin `allowedEnv` change is needed.
  //
  // `minimumReleaseAge: "7 days"` holds any dependency younger than 7 days out of
  // PRs. Security / osvVulnerabilityAlerts PRs are exempt. With this set, set
  // `minimumReleaseAge: 0` in pnpm-workspace.yaml: pnpm 11 defaults the
  // per-install gate to 1440 when the key is absent, and only 0 turns it off.
  // See docs/deployments.md § Dependency updaters.
  // ─────────────────────────────────────────────────────────────────────
  env: {
    PNPM_WORKERS: "1",
    PNPM_MAX_WORKERS: "1",
  },
  minimumReleaseAge: "7 days",

  // Lockfile maintenance — picks up indirect-dependency updates that a
  // direct-dependency bump alone wouldn't catch. Monthly: it rewrites the whole
  // lockfile, so a weekly PR is mostly churn. Every hour of the 1st (UTC), for the
  // same late-start reason as `schedule` above.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* * 1 * *"],
  },

  // Rebase a Renovate PR only when it conflicts. The default re-bases every open PR
  // each time the base branch moves, which re-runs CI on PRs that auto-merge.
  rebaseWhen: "conflicted",

  // A repo-level `ignorePaths` REPLACES the list from `:ignoreModulesAndTests`
  // (pulled in by `config:best-practices`), so that preset's entries are repeated
  // here. `docs/plans/**` holds archived plans and spike code, never live
  // dependencies. `**/tests/**` and `**/__fixtures__/**` hold fixture manifests.
  // `.bkit/templates/**` and `.agents/skills/**` are bkit-owned and stay out of
  // the scan. To keep Renovate off a file entirely, list it here:
  // a packageRule `enabled: false` suppresses version bumps, but the github-actions
  // manager still scans the file and applies tag->SHA pinDigests. Workflows you
  // copied from `.bkit/templates/` (bkit-ci.yml, bkit-cloud.yml, bkit-renovate.yml,
  // bkit-trivy.yml) are yours —
  // leave them out of ignorePaths so their action pins refresh.
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/dist/**",
    "**/build/**",
    "docs/plans/**",
    ".bkit/templates/**",
    ".agents/skills/**",
  ],

  // Caps on open and hourly PRs.
  prConcurrentLimit: 10,
  prHourlyLimit: 4,

  // ─────────────────────────────────────────────────────────────────────
  // Pinned CLIs and tools that live in no package manifest. A comment line
  //   # renovate: datasource=<datasource> depName=<name> [packageName=<n>] [versioning=<v>] [extractVersion=<regex>]
  // directly above the pin tells Renovate what to look up. Forms matched:
  //   ARG NODE_VERSION=24.11.0 · GH_VERSION="2.83.0"      (Dockerfile / shell)
  //   VALE_VERSION: "3.9.1" · renovate-version: "44.x.y"  (workflow env / `with:` input)
  //   GRAPHIFY_SPEC="graphifyy[sql]==0.9.70"              (pip spec in bkit-graphify.sh: value after `==`)
  //   npm install -g @opencode/cli@2.0.26                 (npm global install)
  //   bash "$RUNNER_TEMP/download-actionlint.bash" 1.7.12 (installer-script version argument)
  // Pins paired with a checksum (Vale, gh, jq, Node, actionlint) get the new VERSION
  // from Renovate, but the sha256 beside it stays old: update it by hand in the same
  // PR, or the install fails closed. See the NOTE in the docker images rule below.
  // ─────────────────────────────────────────────────────────────────────
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/(^|/)Dockerfile$/",
        "/(^|/)\\.claude/bkit-cloud\\.md$/",
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/",
        "/(^|/)scripts/graphify/bkit-graphify\\.sh$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>\\S+?)(?: packageName=(?<packageName>\\S+?))?(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+(?:(?:ARG|export)\\s+)?[\\w-]*(?:VERSION|version)[=:]\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>\\S+?)(?: packageName=(?<packageName>\\S+?))?(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+\\w*_SPEC[=:]\\s*\"[^\"=\\s]+==(?<currentValue>[^\"\\s]+)\"",
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>\\S+?)(?: packageName=(?<packageName>\\S+?))?(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+npm install -g \\S+@(?<currentValue>[^\\s\"]+)",
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>\\S+?)(?: packageName=(?<packageName>\\S+?))?(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+bash \"[^\"]+\" (?<currentValue>[0-9][^\\s\"]*)",
      ],
    },
  ],

  packageRules: [
    // ─────────────────────────────────────────────────────────────────────
    // `config:best-practices` sets a 3-day npm release-age gate as a packageRule,
    // which beats the root-level `minimumReleaseAge: "7 days"` for npm packages.
    // This rule restores 7 days. Rules in this file are applied after the preset's
    // rules, so it wins; the preset's `internalChecksFilter: "strict"` stays on.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchDatasources: ["npm"],
      minimumReleaseAge: "7 days",
    },

    // ─────────────────────────────────────────────────────────────────────
    // `renovate-version` in bkit-renovate.yml. Renovate's github-actions manager
    // finds it as a Docker image (ghcr.io/renovatebot/renovate), but ghcr.io tags
    // carry no publish date, so `minimumReleaseAge` would hold every update as
    // "pending" forever. That lookup is switched off; the `customManagers` entry
    // below reads the same line through GitHub releases, which are dated.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["github-actions"],
      matchDepNames: ["ghcr.io/renovatebot/renovate"],
      enabled: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // The bkit package itself — Renovate does not bump it.
    // Upgrade with `pnpm bkit upgrade --latest`, which bumps the pin and
    // re-syncs bkit's files and `.bkit/templates/` in one step.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchPackageNames: ["@cbartens/bkit"],
      enabled: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Every auto-mergeable non-major npm bump lands in ONE PR: the auto-merge
    // rules below share one groupName. Manual-review groups (prod minor,
    // tanstack, vitest, playwright, majors) stay separate.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      // `packageManager` is the pnpm pin in package.json; its bumps join the group.
      matchDepTypes: ["devDependencies", "packageManager"],
      groupName: "non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch"],
      matchDepTypes: ["dependencies"],
      groupName: "non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor"],
      matchDepTypes: ["dependencies"],
      groupName: "minor dependencies",
      // Minor prod bumps are reviewed manually. `false` is explicit so it
      // overrides any earlier matching automerge rule.
      automerge: false,
    },

    // Major bumps — always separate, never auto-merged, and held until you tick
    // the update on the Dependency Dashboard issue (no branch, PR or CI run before).
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      dependencyDashboardApproval: true,
      labels: ["dep-major"],
    },

    // @types/* and the eslint family fold into the unified non-major
    // auto-merge PR above. Scoped to minor/patch; a major bump falls to the
    // majors rule (own PR, no auto-merge).
    {
      matchPackageNames: ["@types/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchPackageNames: ["eslint*", "@eslint/**", "@typescript-eslint/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      automerge: true,
      platformAutomerge: true,
    },

    // Multi-package ecosystems. NON-major bumps fold into the unified
    // auto-merge PR above. A MAJOR bump of each ecosystem (e.g.
    // @tanstack/react-query + @tanstack/query-core, or vitest + @vitest/*)
    // lands as one lockstep PR, reviewed, never auto-merged.
    {
      matchPackageNames: ["@tanstack/**"],
      matchUpdateTypes: ["major"],
      groupName: "major tanstack",
      automerge: false,
    },
    {
      matchPackageNames: ["vitest*", "@vitest/**"],
      matchUpdateTypes: ["major"],
      groupName: "major vitest",
      automerge: false,
    },
    {
      matchPackageNames: ["@playwright/**"],
      matchUpdateTypes: ["major"],
      groupName: "major playwright",
      automerge: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // GitHub Actions — refreshes SHA-pinned `uses:` lines on upstream releases
    // and CVE disclosures (pairs with bkit's SHA-pinning rule in
    // docs/deployments.md § GitHub Actions pinning).
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      // Pin to SHA + tag comment; Renovate maintains the tag comment.
      pinDigests: true,
      // Reviewed manually. `false` is explicit, as in the prod-minor rule.
      automerge: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Docker base images — keeps the `FROM <image>:<tag>@sha256:<digest>`
    // pins fresh on upstream releases and CVE disclosures (pairs with bkit's
    // image-digest pinning in docs/deployments.md § GitHub Actions pinning).
    // The tag must stay INLINE (`ubuntu:26.04@sha256:...`), not in a trailing
    // comment, or the dockerfile manager can't map the digest to its tag.
    // Reviewed manually.
    // NOTE: version+checksum-paired installer fetches (e.g. the Vale tarball
    // sha256, the pinned actionlint download-script SHA in bkit-ci.yml) are only
    // half Renovate-managed — the `customManagers` entry below bumps the version
    // but cannot recompute a tarball checksum — so update those version+sha pairs
    // by hand in the same PR. See docs/deployments.md § GitHub Actions pinning.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["dockerfile"],
      groupName: "docker images",
      automerge: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Pins the `customManagers` entry finds (Dockerfile, bkit-cloud.md, workflows,
    // scripts) land in ONE reviewed PR, so their hand-edited checksums are fixed
    // once. The Dockerfile pnpm pin instead joins the non-major group, so it moves
    // in the same PR as `packageManager` in package.json.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["custom.regex"],
      groupName: "pinned tools",
      automerge: false,
    },
    {
      matchManagers: ["custom.regex"],
      matchDepNames: ["pnpm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
  ],

  // Where to send PRs. `dev` per baseBranchPatterns above.
  // Auto-merge config: Renovate uses GitHub's native auto-merge when
  // `platformAutomerge: true` is set (above), which respects branch
  // protection — required checks must pass before auto-merge fires.
}
