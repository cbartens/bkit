// Renovate configuration shipped by bkit.
// Tier 1 (canonical-overwrite): bkit owns this file. Rewritten on every
// `bkit install`. Do NOT edit by hand — changes will be overwritten.
//
// Reference: https://docs.renovatebot.com/configuration-options/
//
// Renovate App install is one-click via GitHub UI (https://github.com/apps/renovate).
// No `gh api` equivalent exists. See bkit issue #123 for the migration prompt.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Extend Renovate's curated baseline. `config:recommended` enables the
  // sensible defaults (timezone-aware schedules, dependency-dashboard, etc.).
  //
  // `local>{{REPO_SLUG}}//.github/renovate-local.json5` pulls in `.github/renovate-local.json5`,
  // a CONSUMER-OWNED file bkit does NOT manage. This file (renovate.json5) is
  // Tier-1 canonical-overwrite — rewritten on every `bkit install` — so hand-edits
  // here are clobbered. Put repo-specific Renovate rules in renovate-local.json5
  // instead; they survive `bkit install`/`bkit upgrade`. It's listed LAST so it
  // wins over the presets above. Precedence caveat: extended-preset packageRules
  // are evaluated BEFORE this config's inline packageRules below, so renovate-local
  // can ADD rules and set keys bkit leaves unset (notably `enabled: false` to fence
  // a package — bkit never sets `enabled: true`), but it canNOT override a key bkit
  // sets explicitly (e.g. `automerge`). Renovate resolves the preset from the
  // DEFAULT branch; append `#<branch>` to resolve from another branch.
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    "local>{{REPO_SLUG}}//.github/renovate-local.json5",
  ],

  // bkit consumers gate `main` to PRs-from-`dev`-only. Renovate must open
  // PRs against `dev`, not the default branch.
  baseBranches: ["dev"],

  // Renovate reads its config ONLY from the repository's default branch (`main`).
  // With `baseBranches: ["dev"]` and this unset, edits to `renovate.json5` on `dev`
  // are invisible to Renovate — every config change would otherwise need a release
  // to `main` to take effect. `merge` layers `dev`'s config over `main`'s for the
  // dev-targeted runs, so ongoing config edits can live on `dev`. Bootstrap caveat:
  // this option is itself read from `main`, so it needs ONE merge to `main` before
  // dev-side config edits are honored. See docs/deployments.md § GitHub Actions pinning.
  useBaseBranchConfig: "merge",

  // Weekly batched runs — keeps PR noise low. CVE-driven updates fire
  // immediately regardless of schedule via `osvVulnerabilityAlerts`.
  schedule: ["before 6am on Monday"],
  timezone: "UTC",

  // CVE alerts → Renovate opens a PR immediately, bypassing the weekly schedule.
  // Equivalent to Dependabot's `automated-security-fixes` but routed to `dev`
  // (via baseBranches above) so bkit branch protection accepts them.
  osvVulnerabilityAlerts: true,

  // Conventional-commit prefix to match the rest of the repo history.
  commitMessagePrefix: "chore(deps):",

  // ─────────────────────────────────────────────────────────────────────
  // pnpm 11 supply-chain freshness + Renovate-runner memory ceiling (#308).
  //
  // On a large pnpm-11 monorepo, `pnpm update --lockfile-only` — especially
  // alongside a pnpm-level `minimumReleaseAge` gate verifying publish
  // timestamps for every lockfile entry — can exceed the physical memory of
  // Mend's hosted microvm and fail the job with `kernel-out-of-memory` (a
  // physical OOM, not a V8 heap limit), blocking every dependency PR. CI and
  // Vercel pass because those runners have far more RAM. Two layered
  // mitigations, both scoped to Renovate:
  //
  // (A) Cap pnpm's worker pool so peak memory stays bounded. PNPM_WORKERS /
  //     PNPM_MAX_WORKERS are allow-listed by Mend's `global:safeEnv` preset, so
  //     no admin `allowedEnv` change is needed; `env` scopes to Renovate's
  //     runner only (CI/Vercel/local installs are untouched). Cheap and
  //     reversible, but may NOT clear a metadata-driven OOM on its own —
  //     `--lockfile-only` barely engages the worker pool.
  //
  // (B) Enforce release-age freshness in Renovate itself rather than the
  //     per-install pnpm gate. `minimumReleaseAge: "1 day"` holds any dep
  //     younger than 24h out of PRs, with NO per-install timestamp
  //     verification — removing the memory spike at the source and speeding
  //     every CI/Vercel build. Security / osvVulnerabilityAlerts PRs bypass
  //     this by design, so CVE fixes are never delayed. To actually clear the
  //     OOM the consumer must also set `minimumReleaseAge: 0` in
  //     pnpm-workspace.yaml — pnpm 11 defaults the gate to 1440, so DELETING the
  //     key leaves it active (and drops the @cbartens/* exclusion, breaking
  //     same-day bkit upgrades); only 0 short-circuits the per-entry check. It
  //     trades away pnpm-level defense against manual/transitive fresh installs.
  //     See docs/deployments.md § Renovate pnpm-11 freshness gate & microvm memory.
  // ─────────────────────────────────────────────────────────────────────
  env: {
    PNPM_WORKERS: "1",
    PNPM_MAX_WORKERS: "1",
  },
  minimumReleaseAge: "1 day",

  // Lockfile maintenance — picks up indirect-dependency updates that a
  // direct-dependency bump alone wouldn't catch. Same weekly slot.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on Monday"],
  },

  // Respect ignore paths from .gitignore + add common monorepo cruft.
  // `.bkit/templates/**` and `.agents/skills/**` are bkit-owned files NOT managed
  // by consumer Renovate — scanning them only produces onboarding noise (and an
  // unauthable `@cbartens/bkit` lookup). See issue #132.
  // `bkit-cloud.yml` is bkit-owned too and tag-pinned by design (new SHAs arrive
  // via `bkit install`). It MUST be ignored here, not merely fenced by the
  // packageRule below: `enabled: false` suppresses version bumps but the
  // github-actions manager still SCANS the file and applies its tag->SHA
  // pinDigests, recreating a "Pin dependencies" PR on every scan. ignorePaths
  // stops the scan outright.
  ignorePaths: [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    ".bkit/templates/**",
    ".agents/skills/**",
    ".github/workflows/bkit-cloud.yml",
  ],

  // ─────────────────────────────────────────────────────────────────────
  // Private-registry read auth (`@cbartens/bkit` on npm.pkg.github.com) is
  // configured in the consumer-owned `.github/renovate-local.json5`, NOT here.
  // Renovate merges `hostRules` across extended presets, so the token set there
  // SURVIVES every `bkit upgrade` — whereas this file is canonical-overwrite and
  // would clobber a token added here on the next install.
  // Without that token Renovate's lockfile regen 401s, every dependency PR lands
  // with a stale lockfile, and CI fails `pnpm install --frozen-lockfile`
  // (ERR_PNPM_OUTDATED_LOCKFILE). Activation recipe: `.github/renovate-local.json5`
  // and docs/deployments.md § Renovate read-auth.
  // ─────────────────────────────────────────────────────────────────────

  // Cap concurrent PRs so a major-version flood doesn't drown the repo.
  prConcurrentLimit: 10,
  prHourlyLimit: 4,

  packageRules: [
    // ─────────────────────────────────────────────────────────────────────
    // bkit-managed workflow files — DO NOT BUMP.
    // bkit ships these via `bkit install`. Consumer-side Renovate must stay
    // out of them; new SHAs/versions arrive when consumers bump the bkit
    // package and re-run `bkit install`. The primary fence is `ignorePaths`
    // above (stops the scan AND the tag->SHA pinning that recreated the "Pin
    // dependencies" PR); this rule is a secondary guard that still suppresses
    // version bumps should the file ever be removed from ignorePaths.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchFileNames: [
        ".github/workflows/bkit-cloud.yml",
      ],
      enabled: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // The bkit package itself — DO NOT BUMP via Renovate.
    // bkit upgrades via `pnpm add -D @cbartens/bkit@latest && pnpm bkit upgrade`,
    // which re-syncs templates, substitutes tokens, and bumps the pin. A bare
    // version bump skips that and leaves the consumer split-brain. The package
    // also lives on GitHub Packages (restricted), which Mend's hosted runner has
    // no token for — so Renovate only ever logs a "no-result" lookup. See #132.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchPackageNames: ["@cbartens/bkit"],
      enabled: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Collapse every auto-mergeable non-major npm bump into ONE PR.
    // Each Renovate PR rewrites pnpm-lock.yaml, so several firing in the same
    // window force serial rebases and stall platformAutomerge. Sharing one
    // groupName across the auto-merge rules below means a single weekly
    // lockfile mutation, one merge, and no rebase cascade. Manual-review
    // groups (prod minor, tanstack, vitest, playwright, majors) stay separate.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["devDependencies"],
      groupName: "non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch"],
      matchDepTypes: ["dependencies"],
      groupName: "non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor"],
      matchDepTypes: ["dependencies"],
      groupName: "minor dependencies",
      // Minor prod bumps ship new behavior to users — review manually.
      // Explicit (not just absent) so the policy is greppable and can't be
      // silently flipped true by an earlier automerge rule.
      automerge: false,
    },

    // Major bumps — always separate, never auto-merged. A human reads the
    // changelog.
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dep-major"],
    },

    // @types/* and the eslint family fold into the unified non-major
    // auto-merge PR above. Scoped to non-major so a major bump falls to the
    // majors rule (own PR, no auto-merge) instead of poisoning the group's
    // auto-merge — these pattern rules carry no updateType filter otherwise.
    {
      matchPackagePatterns: ["^@types/"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchPackagePatterns: ["^eslint", "^@eslint/", "^@typescript-eslint/"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      automerge: true,
      platformAutomerge: true,
    },

    // Multi-package ecosystems. NON-major bumps fold into the unified
    // auto-merge PR above (peer-deps still move together inside that one PR).
    // Only MAJOR bumps get a dedicated lockstep PR — a coordinated breaking
    // bump (e.g. @tanstack/react-query + @tanstack/query-core, or vitest +
    // @vitest/*) must land together and is reviewed, never auto-merged.
    // Without the major scope each would split into a separate per-package PR
    // and the halves would fail CI against each other.
    {
      matchPackagePatterns: ["^@tanstack/"],
      matchUpdateTypes: ["major"],
      groupName: "major tanstack",
      automerge: false,
    },
    {
      matchPackagePatterns: ["^vitest", "^@vitest/"],
      matchUpdateTypes: ["major"],
      groupName: "major vitest",
      automerge: false,
    },
    {
      matchPackagePatterns: ["^@playwright/"],
      matchUpdateTypes: ["major"],
      groupName: "major playwright",
      automerge: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // GitHub Actions — refreshes SHA-pinned `uses:` lines on upstream releases
    // and CVE disclosures (pairs with bkit's SHA-pinning rule in
    // docs/deployments.md § GitHub Actions pinning).
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      // Pin to SHA + tag comment; Renovate maintains the tag comment.
      pinDigests: true,
      // Reviewed manually — a workflow action bump can change CI behavior.
      // Explicit false for the same greppability reason as the prod-minor rule.
      automerge: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Docker base images — keeps the `FROM <image>:<tag>@sha256:<digest>`
    // pins fresh on upstream releases and CVE disclosures (pairs with bkit's
    // image-digest pinning in docs/deployments.md § GitHub Actions pinning).
    // The tag must stay INLINE (`ubuntu:26.04@sha256:...`), not in a trailing
    // comment, or the dockerfile manager can't map the digest to its tag.
    // Reviewed manually — a base-image bump can shift the build toolchain.
    // NOTE: version+checksum-paired installer fetches (e.g. the Vale tarball
    // sha256, the pinned actionlint download-script SHA in ci.yml) are NOT
    // Renovate-managed — it cannot recompute a tarball checksum — so bump those
    // version+sha pairs by hand. See docs/deployments.md § GitHub Actions pinning.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["dockerfile"],
      groupName: "docker images",
      automerge: false,
    },
  ],

  // Where to send PRs. `dev` per baseBranches above.
  // Auto-merge config: Renovate uses GitHub's native auto-merge when
  // `platformAutomerge: true` is set (above), which respects branch
  // protection — required checks must pass before auto-merge fires.
}
