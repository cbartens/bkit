// Example Renovate config. Copy it to `.github/renovate.json5` and own it.
// bkit install does not write this file and does not overwrite a copy.
//
// Reference: https://docs.renovatebot.com/configuration-options/
//
// Mend App install is one-click via GitHub UI (https://github.com/apps/renovate).
// No `gh api` equivalent exists. Land this file on the default branch before
// installing the App. Self-hosted runner: copy
// `.bkit/templates/.github/workflows/bkit-renovate.yml` as well, and suspend the
// Mend App for this repo so both do not open the same PRs.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // `config:recommended` is Renovate's curated baseline (timezone-aware schedules,
  // dependency dashboard, etc.). Repo-specific rules go in this file.
  // A `local>` preset with no `#` is read from the default branch. `useBaseBranchConfig`
  // does not change that fetch. Append the branch `baseBranchPatterns` names — a branch
  // after `#` works (branch, tag, or commit SHA):
  //   "local>owner/repo//path/to/preset.json5#dev"
  // The `extends` line itself is still read from the default branch, so `#dev` needs
  // one merge there before edits on `dev` apply.
  extends: [
    "config:recommended",
    ":dependencyDashboard",
  ],

  // Renovate opens PRs against `dev`, not the default branch. `main` accepts
  // PRs from `dev` only.
  baseBranchPatterns: ["dev"],

  // Renovate reads its config from the default branch (`main`). `merge` layers
  // `dev`'s config over `main`'s for dev-targeted runs, so config edits on `dev`
  // apply to them. This option is itself read from `main`, so it needs one merge
  // to `main` before dev-side config edits apply.
  // See docs/deployments.md § Dependency updaters.
  useBaseBranchConfig: "merge",

  // Weekly batched runs. CVE-driven updates are not held to this schedule
  // (`osvVulnerabilityAlerts` below).
  schedule: ["before 6am on Monday"],
  timezone: "UTC",

  // CVE alerts → Renovate opens a PR immediately, outside the weekly schedule.
  // These PRs target `dev` (baseBranchPatterns above).
  osvVulnerabilityAlerts: true,

  // Conventional-commit prefix.
  commitMessagePrefix: "chore(deps):",

  // ─────────────────────────────────────────────────────────────────────
  // pnpm 11 release-age freshness + Renovate-runner memory ceiling.
  //
  // `env` caps pnpm's worker pool at 1 in Renovate's runner only; CI, Vercel
  // and local installs are untouched. PNPM_WORKERS / PNPM_MAX_WORKERS are on
  // Mend's `global:safeEnv` allow-list, so no admin `allowedEnv` change is needed.
  //
  // `minimumReleaseAge: "7 days"` holds any dependency younger than 7 days out of
  // PRs. Security / osvVulnerabilityAlerts PRs are exempt. With this set, set
  // `minimumReleaseAge: 0` in pnpm-workspace.yaml: pnpm 11 defaults the
  // per-install gate to 1440 when the key is absent, and only 0 turns it off.
  // See docs/deployments.md § Dependency updaters.
  // ─────────────────────────────────────────────────────────────────────
  env: {
    PNPM_WORKERS: "1",
    PNPM_MAX_WORKERS: "1",
  },
  minimumReleaseAge: "7 days",

  // Lockfile maintenance — picks up indirect-dependency updates that a
  // direct-dependency bump alone wouldn't catch. Same weekly slot.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on Monday"],
  },

  // Respect ignore paths from .gitignore + add common monorepo cruft.
  // `.bkit/templates/**` and `.agents/skills/**` are bkit-owned and stay out of
  // the scan. To keep Renovate off a file entirely, list it here:
  // a packageRule `enabled: false` suppresses version bumps, but the github-actions
  // manager still scans the file and applies tag->SHA pinDigests. Workflows you
  // copied from `.bkit/templates/` (bkit-ci.yml, bkit-cloud.yml, bkit-renovate.yml,
  // bkit-trivy.yml) are yours —
  // leave them out of ignorePaths so their action pins refresh.
  ignorePaths: [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    ".bkit/templates/**",
    ".agents/skills/**",
  ],

  // Caps on open and hourly PRs.
  prConcurrentLimit: 10,
  prHourlyLimit: 4,

  packageRules: [
    // ─────────────────────────────────────────────────────────────────────
    // The bkit package itself — Renovate does not bump it.
    // Upgrade with `pnpm bkit upgrade --latest`, which bumps the pin and
    // re-syncs bkit's files and `.bkit/templates/` in one step.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchPackageNames: ["@cbartens/bkit"],
      enabled: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Every auto-mergeable non-major npm bump lands in ONE PR: the auto-merge
    // rules below share one groupName. Manual-review groups (prod minor,
    // tanstack, vitest, playwright, majors) stay separate.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["devDependencies"],
      groupName: "non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch"],
      matchDepTypes: ["dependencies"],
      groupName: "non-major dependencies",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor"],
      matchDepTypes: ["dependencies"],
      groupName: "minor dependencies",
      // Minor prod bumps are reviewed manually. `false` is explicit so it
      // overrides any earlier matching automerge rule.
      automerge: false,
    },

    // Major bumps — always separate, never auto-merged.
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dep-major"],
    },

    // @types/* and the eslint family fold into the unified non-major
    // auto-merge PR above. Scoped to minor/patch; a major bump falls to the
    // majors rule (own PR, no auto-merge).
    {
      matchPackageNames: ["@types/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      automerge: true,
      platformAutomerge: true,
    },
    {
      matchPackageNames: ["eslint*", "@eslint/**", "@typescript-eslint/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "non-major dependencies",
      automerge: true,
      platformAutomerge: true,
    },

    // Multi-package ecosystems. NON-major bumps fold into the unified
    // auto-merge PR above. A MAJOR bump of each ecosystem (e.g.
    // @tanstack/react-query + @tanstack/query-core, or vitest + @vitest/*)
    // lands as one lockstep PR, reviewed, never auto-merged.
    {
      matchPackageNames: ["@tanstack/**"],
      matchUpdateTypes: ["major"],
      groupName: "major tanstack",
      automerge: false,
    },
    {
      matchPackageNames: ["vitest*", "@vitest/**"],
      matchUpdateTypes: ["major"],
      groupName: "major vitest",
      automerge: false,
    },
    {
      matchPackageNames: ["@playwright/**"],
      matchUpdateTypes: ["major"],
      groupName: "major playwright",
      automerge: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // GitHub Actions — refreshes SHA-pinned `uses:` lines on upstream releases
    // and CVE disclosures (pairs with bkit's SHA-pinning rule in
    // docs/deployments.md § GitHub Actions pinning).
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      // Pin to SHA + tag comment; Renovate maintains the tag comment.
      pinDigests: true,
      // Reviewed manually. `false` is explicit, as in the prod-minor rule.
      automerge: false,
    },

    // ─────────────────────────────────────────────────────────────────────
    // Docker base images — keeps the `FROM <image>:<tag>@sha256:<digest>`
    // pins fresh on upstream releases and CVE disclosures (pairs with bkit's
    // image-digest pinning in docs/deployments.md § GitHub Actions pinning).
    // The tag must stay INLINE (`ubuntu:26.04@sha256:...`), not in a trailing
    // comment, or the dockerfile manager can't map the digest to its tag.
    // Reviewed manually.
    // NOTE: version+checksum-paired installer fetches (e.g. the Vale tarball
    // sha256, the pinned actionlint download-script SHA in bkit-ci.yml) are NOT
    // Renovate-managed — it cannot recompute a tarball checksum — so bump those
    // version+sha pairs by hand. See docs/deployments.md § GitHub Actions pinning.
    // ─────────────────────────────────────────────────────────────────────
    {
      matchManagers: ["dockerfile"],
      groupName: "docker images",
      automerge: false,
    },
  ],

  // Where to send PRs. `dev` per baseBranchPatterns above.
  // Auto-merge config: Renovate uses GitHub's native auto-merge when
  // `platformAutomerge: true` is set (above), which respects branch
  // protection — required checks must pass before auto-merge fires.
}
