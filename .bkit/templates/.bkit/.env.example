# .bkit/.env — local secrets for MCP servers and agent tooling, shipped by bkit.
# Tier 3 (seed-or-print): bkit writes this file once if absent; if present
# bkit will not overwrite — see the install advisory for the recommended merge.
#
# Copy this file to .bkit/.env (gitignored), fill in your values, then run:
#   direnv allow
# direnv will auto-export these into your shell whenever you cd into this repo.
#
# Cloud sessions (Claude on the web, Cursor Background Agents) set the SAME
# variable names in their respective dashboards — never in this file.

# GH_BKIT_TOKEN — GitHub classic PAT with `read:packages` scope. Used by pnpm
# to authenticate to the GitHub Packages npm registry (npm.pkg.github.com) for
# @cbartens/* packages. Fine-grained PATs are rejected by GitHub Packages
# (HTTP 403) — must be classic.
# Generate at: https://github.com/settings/tokens (Tokens (classic) → Generate)
GH_BKIT_TOKEN=

# GH_TOKEN — GitHub fine-grained PAT. Used by the GitHub MCP server
# (api.githubcopilot.com/mcp/) via Authorization header in .mcp.json, and by
# the gh CLI. Required permissions: Contents R/W, Pull requests R/W, Issues
# R/W, Actions R/W, Workflows R/W, Metadata R. Scope to the repos you'll work on.
# Generate at: https://github.com/settings/personal-access-tokens
GH_TOKEN=

# LINEAR_API_KEY — Linear personal API key. Used by the Linear MCP server
# (mcp.linear.app/mcp) and by the Linear preflight hook in
# .claude/hooks/preflight.sh and .cursor/hooks/preflight.sh.
# Generate at: https://linear.app/settings/api
LINEAR_API_KEY=

# ANTHROPIC_API_KEY — Anthropic API key. Only needed if you run Claude Code
# without a Claude subscription (pay-per-token mode). Subscription users leave
# blank.
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# CURSOR_API_KEY — Cursor API key. Only needed if you dispatch Cursor cloud
# agents from this shell (programmatic POST /v0/agents, model catalog queries
# via `curl https://api.cursor.com/v0/models -u "$CURSOR_API_KEY:"`). The
# Cursor desktop IDE does NOT use this — it authenticates via its own login.
# Generate at: https://cursor.com/settings → API Keys
CURSOR_API_KEY=

# ---------------------------------------------------------------------------
# Observability / debug-fetch (operator creds for docs/observability.md blocks)
# ---------------------------------------------------------------------------
# These power the `/bkit-debug` debug-fetch blocks in docs/observability.md.
# They are OPERATOR / observability creds — account-level, READ-ONLY log access
# used by a human or the debug agent. They are NOT app-runtime secrets: do NOT
# put your app's Supabase service_role/anon key, database URL, or Vercel project
# env here — those belong in your host's per-env config (e.g. apps/*/.env, pulled
# from Vercel), never in .bkit/.env.
#
# The *_TOKEN values are secret → set them here (local) AND in your cloud agent
# dashboard (Claude/Cursor) if you run /bkit-debug in the cloud; a cloud agent
# never sees this file. The token is identical across preview/prod — only the
# non-secret SELECTOR (scope / project ref / --environment) changes, and a
# selector can instead be committed directly in your copied debug-fetch block so
# cloud agents inherit it with zero dashboard config. Seed only the sources you use.

# VERCEL_TOKEN — Vercel access token for non-interactive `vercel logs` (cloud
# agents are headless — they cannot `vercel login`). Generate at:
# https://vercel.com/account/settings/tokens
VERCEL_TOKEN=
# VERCEL_SCOPE — non-secret team slug selector (`--scope`). Commit in-block for cloud.
VERCEL_SCOPE=

# SUPABASE_ACCESS_TOKEN — Supabase Management API token (account-level, read logs).
# NOT your project's service_role/anon key. Generate at:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_ID — non-secret project ref selector. Commit in-block for cloud.
SUPABASE_PROJECT_ID=

# GOOGLE_APPLICATION_CREDENTIALS — path to a GCP service-account JSON for
# non-interactive `gcloud` (cloud agents cannot `gcloud auth login`). Point it at
# a read-only logging service account. The GCP project id is a non-secret selector.
GOOGLE_APPLICATION_CREDENTIALS=
