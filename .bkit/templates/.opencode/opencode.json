{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "grep": "allow",
    "glob": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME/*": "deny",
      "git push --force-with-lease*": "allow"
    }
  },
  "mcp": {
    "@@OPENCODE_TRACKER_MCP@@": {}
  },
  "plugin": [".opencode/plugin/gateguard.js"],
  "provider": {
    "@@OPENCODE_PROVIDER_KEY@@": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "@@OPENCODE_PROVIDER_KEY@@",
      "options": {
        "baseURL": "@@OPENCODE_PROVIDER_BASE_URL@@",
        "apiKey": "{env:@@OPENCODE_PROVIDER_ENV_VAR@@}"
      }
    }
  }
}
