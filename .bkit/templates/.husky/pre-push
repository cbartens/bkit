#!/usr/bin/env sh
# bkit pre-push (Tier-3 seed-or-print — modify freely). FAST deterministic gates only:
# typecheck + unit tests + format:check + the bkit drift gate (no Docker/network). Heavier
# tiers run in CI, NOT here: integration + E2E -> bkit-tests (gated on web_affected / run_e2e);
# @live -> bkit-tests-live; "did the planned tiers run?" -> bkit-tests-check. See ci.yml
# § FULL CI SCAFFOLD REFERENCE — keep slow/network/deploy checks OUT so a green push never
# implies more than these gates verified. Turbo monorepos: scope with
# `--filter="...[origin/<default>]"` + `pnpm slop:delta`; never add integration/E2E/@live.
#
# Revert-branch bypass: rolling back leaves the tree intentionally inconsistent (deleted
# files referenced by surviving tests) — skip the suite so recovery lands; lint + typecheck still run.
set -e
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
HEAD_SUBJECT=$(git log -1 --pretty=%s 2>/dev/null || echo "")
IS_REVERT=0
case "$BRANCH" in
  revert-*) IS_REVERT=1 ;;
esac
case "$HEAD_SUBJECT" in
  'Revert "'*) IS_REVERT=1 ;;
esac
if [ "$IS_REVERT" = "1" ]; then
  echo "[pre-push] revert branch/commit detected — running typecheck + format:check only"
  pnpm typecheck && pnpm format:check
else
  pnpm typecheck && pnpm test && pnpm format:check
fi

# bkit mirror-drift gate — fails fast if `.agents/*` was edited without `bkit install`
# regenerating the `.claude/*`/`.cursor/*`/`.husky/*` mirrors (same check CI runs).
# Fix: `pnpm bkit install`, stage the regenerated files, commit, push.
pnpm bkit check < /dev/null
