#!/usr/bin/env sh
# pre-push hook shipped by bkit. Tier 3 (seed-or-print): bkit writes this file
# once if absent; if present bkit will not overwrite — modify freely.
#
# Revert-branch bypass: when rolling back, the source tree is intentionally
# inconsistent (deleted files referenced by surviving tests). Skip the test
# suite so the recovery push can land; lint + typecheck still run.
set -e
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
HEAD_SUBJECT=$(git log -1 --pretty=%s 2>/dev/null || echo "")
IS_REVERT=0
case "$BRANCH" in
  revert-*) IS_REVERT=1 ;;
esac
case "$HEAD_SUBJECT" in
  'Revert "'*) IS_REVERT=1 ;;
esac
if [ "$IS_REVERT" = "1" ]; then
  echo "[pre-push] revert branch/commit detected — running typecheck + format:check only"
  pnpm typecheck && pnpm format:check
else
  pnpm typecheck && pnpm test && pnpm format:check
fi

# bkit mirror-drift gate — fails fast locally if `.agents/*` was edited without
# `bkit install` regenerating the `.claude/*` / `.cursor/*` / `.husky/*` mirrors.
# Same check CI runs (`.github/workflows/ci.yml`); catching it here saves a CI
# round-trip. Fix on failure: `pnpm bkit install`, stage the regenerated files,
# commit, push.
pnpm bkit check < /dev/null
