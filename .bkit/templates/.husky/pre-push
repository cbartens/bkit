#!/usr/bin/env sh
# bkit pre-push (Tier-3 seed-or-print — modify freely). FAST deterministic gates only:
# typecheck + unit tests + format:check + prose + the enforcing slop gate (slop:delta) +
# the bkit drift gate (no Docker/network). This is the full deterministic mirror of CI, so
# a green push can't red-CI on those gates. Heavier tiers run in CI, NOT here: integration +
# E2E -> bkit-tests (gated on web_affected / run_e2e); @live -> bkit-tests-live; "did the
# planned tiers run?" -> bkit-tests-check. See ci.yml § FULL CI SCAFFOLD REFERENCE — keep
# slow/network/deploy checks OUT so a green push never implies more than these gates
# verified. Turbo monorepos: scope tests with `--filter="...[origin/<default>]"`; never add
# integration/E2E/@live.
#
# Revert-branch bypass: rolling back leaves the tree intentionally inconsistent (deleted
# files referenced by surviving tests) — skip the suite so recovery lands; lint + typecheck still run.
set -e
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
HEAD_SUBJECT=$(git log -1 --pretty=%s 2>/dev/null || echo "")
IS_REVERT=0
case "$BRANCH" in
  revert-*) IS_REVERT=1 ;;
esac
case "$HEAD_SUBJECT" in
  'Revert "'*) IS_REVERT=1 ;;
esac

# CI-suppressor HEAD guard. A [skip ci]-class token on the HEAD commit of a branch with an
# OPEN PR silences GitHub's pull_request trigger -> empty statusCheckRollup -> a PR that
# merges without ever running CI. The workflow CI-Dispatch gate only covers the push it
# makes at close; this backstops MANUAL pushes (rebase + force-push, post-close commits).
# Conditioned on an open PR so it never blocks sanctioned [skip ci] pushes with no PR
# (mid-loop status, abort handover). dev/main exempt; gh absent -> allow (backstop only).
case "$BRANCH" in
  dev|main) ;;
  *)
    if git log -1 --pretty=%B | grep -iEq '\[skip ci\]|\[ci skip\]|\[no ci\]|\[skip actions\]|\[actions skip\]'; then
      if command -v gh >/dev/null 2>&1; then
        # strip hook-injected GIT_DIR/GIT_WORK_TREE so gh resolves the repo from cwd (worktree-safe)
        OPEN_PR=$(env -u GIT_DIR -u GIT_WORK_TREE gh pr list --head "$BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null || echo "")
        if [ -n "$OPEN_PR" ]; then
          echo "[pre-push] BLOCKED: HEAD on '$BRANCH' carries a CI-suppressing token and PR #$OPEN_PR is open — its checks would stay vacuously green." >&2
          echo "[pre-push] Add a clean trigger commit and re-push:  git commit --allow-empty -m \"chore: trigger CI\" && git push" >&2
          exit 1
        fi
      else
        echo "[pre-push] WARN: HEAD on '$BRANCH' carries a CI-suppressing token but gh is unavailable to check for an open PR; allowing. If a PR is open, ensure HEAD triggers CI." >&2
      fi
    fi
    ;;
esac

if [ "$IS_REVERT" = "1" ]; then
  echo "[pre-push] revert branch/commit detected — running typecheck + format:check only"
  pnpm typecheck && pnpm format:check
else
  pnpm typecheck && pnpm test && pnpm format:check
fi

# Prose + the enforcing slop gate run here too, so pre-push is a full deterministic mirror
# of CI. prose = vale (guard-skips if vale/write-good absent — install to enforce locally);
# slop:delta fails ONLY on findings this push ADDS or WORSENS vs origin/<default>, never the
# pre-existing baseline. Both are safe on revert pushes (md prose is unaffected by deleted
# code; removals show as 'resolved', never 'added').
pnpm lint:prose < /dev/null
pnpm slop:delta < /dev/null

# bkit mirror-drift gate — fails fast if `.agents/*` was edited without `bkit install`
# regenerating the `.claude/*`/`.cursor/*`/`.husky/*` mirrors (same check CI runs).
# Fix: `pnpm bkit install`, stage the regenerated files, commit, push.
pnpm bkit check < /dev/null
