#!/usr/bin/env sh
# bkit pre-push. Example. Copy into the repo and own it.
# bkit install does not write this file and does not overwrite a copy.
#
# FAST deterministic gates only: the `bkit:gate` script (typecheck + unit tests +
# format:check + prose + the enforcing slop gate) plus the bkit drift gate (no
# Docker/network) — the full deterministic mirror of CI. Heavier tiers run in CI, NOT
# here: integration + E2E -> bkit-tests (gated on web_affected / run_e2e); @live ->
# bkit-tests-live; "did the planned tiers run?" -> bkit-tests-check. See bkit-ci.yml § FULL
# CI SCAFFOLD REFERENCE — keep slow/network/deploy checks OUT. Turbo monorepos: scope
# tests inside the `bkit:gate*` scripts with
# `--filter="...[origin/<default>]"`; never add integration/E2E/@live.
#
# Revert-branch bypass: on a revert branch the suite is skipped; lint + typecheck still run.
#
# Min push: every changed file matches `bkit.minPushPaths` (package.json; default plan logs,
# ledgers) → `bkit:gate:min` replaces the full gate; MIN_PUSH=1 for repo extras. Files decide,
# never `[skip ci]`.
set -e

# ── delete-only push: nothing leaves this machine, so there is nothing to gate ──
# `git push origin --delete <branch>` runs this hook too. Git feeds one line per ref on
# stdin — "<local-ref> <local-sha> <remote-ref> <remote-sha>" — and a deleted ref has an
# all-zero local sha. When EVERY line is a delete, the push carries no commits. A push
# mixing a delete with a real update still gates, and so does an empty ref list. Reading
# stdin here is safe: every later command redirects from /dev/null. `[ -t 0 ]` keeps a
# hand-run hook from hanging. The loop also sets PUSH_DEV_SHA (commit pushed to dev) for
# repo extras that gate only dev pushes (e.g. scripts/graphify/bkit-graph-pre-push.sh),
# PUSH_SHAS (every pushed commit) and PUSH_SHARED_SHAS (those pushed to dev / main).
PUSH_SAW_REF=0
PUSH_HAS_COMMITS=0
PUSH_DEV_SHA=""
PUSH_SHAS=""
PUSH_SHARED_SHAS=""
if [ ! -t 0 ]; then
  while read -r _push_local_ref push_local_sha push_remote_ref _push_remote_sha; do
    [ -n "$push_local_sha" ] || continue
    PUSH_SAW_REF=1
    case "$push_local_sha" in
      *[!0]*)
        PUSH_HAS_COMMITS=1
        PUSH_SHAS="$PUSH_SHAS $push_local_sha"
        [ "$push_remote_ref" = "refs/heads/dev" ] && PUSH_DEV_SHA="$push_local_sha"
        case "$push_remote_ref" in
          refs/heads/dev|refs/heads/main) PUSH_SHARED_SHAS="$PUSH_SHARED_SHAS $push_local_sha" ;;
        esac
        ;;
    esac
  done
fi
if [ "$PUSH_SAW_REF" = "1" ] && [ "$PUSH_HAS_COMMITS" = "0" ]; then
  echo "[pre-push] delete-only push — no commits to check, gates skipped" >&2
  exit 0
fi
# ── end delete-only push

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
HEAD_SUBJECT=$(git log -1 --pretty=%s 2>/dev/null || echo "")
IS_REVERT=0
case "$BRANCH" in
  revert-*) IS_REVERT=1 ;;
esac
case "$HEAD_SUBJECT" in
  'Revert "'*) IS_REVERT=1 ;;
esac

# CI-suppressor HEAD guard: blocks a push whose HEAD commit carries a [skip ci]-class
# token while the branch has an OPEN PR (that token silences GitHub's pull_request
# trigger). Covers manual pushes (rebase + force-push, post-close commits). No open PR
# -> allowed ([skip ci] pushes for mid-loop status, abort handover). dev/main exempt;
# gh absent -> allow. `bkit ci skip-token` exits 0 when HEAD's message carries one of
# the tokens GitHub honours; bkit owns that list.
case "$BRANCH" in
  dev|main) ;;
  *)
    if pnpm -s bkit ci skip-token < /dev/null > /dev/null; then
      if command -v gh >/dev/null 2>&1; then
        # strip hook-injected GIT_DIR/GIT_WORK_TREE so gh resolves the repo from cwd (worktree-safe)
        OPEN_PR=$(env -u GIT_DIR -u GIT_WORK_TREE gh pr list --head "$BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null || echo "")
        if [ -n "$OPEN_PR" ]; then
          echo "[pre-push] BLOCKED: HEAD on '$BRANCH' carries a CI-suppressing token and PR #$OPEN_PR is open — its checks would stay vacuously green." >&2
          echo "[pre-push] Add a clean trigger commit and re-push:  git commit --allow-empty -m \"chore: trigger CI\" && git push" >&2
          exit 1
        fi
      else
        echo "[pre-push] WARN: HEAD on '$BRANCH' carries a CI-suppressing token but gh is unavailable to check for an open PR; allowing. If a PR is open, ensure HEAD triggers CI." >&2
      fi
    fi
    ;;
esac

# Min push: `bkit ci min-push` exits 0 only when every file changed since each pushed
# commit left origin/dev (else origin/main) matches `bkit.minPushPaths`. Anything else
# (code, no files, unreadable range, no refs) → MIN_PUSH=0, full gate: a skip on no
# evidence reads as a pass.
MIN_PUSH=0
if [ -n "$PUSH_SHAS" ]; then
  MIN_PUSH_REFS=""
  for push_sha in $PUSH_SHAS; do MIN_PUSH_REFS="$MIN_PUSH_REFS --ref=$push_sha"; done
  # shellcheck disable=SC2086 # hex SHAs only: word-splitting is the point
  if pnpm -s bkit ci min-push $MIN_PUSH_REFS < /dev/null > /dev/null; then
    MIN_PUSH=1
  fi
fi

# CI-suppressor guard on dev / main: a skip-CI token on a push's LAST commit skips CI for the
# whole push, so code would land untested. Blocked unless a min push. Feature branches keep
# the open-PR guard above (workflows push `[skip ci]` code heads mid-run).
for push_sha in $PUSH_SHARED_SHAS; do
  if pnpm -s bkit ci skip-token --ref="$push_sha" < /dev/null > /dev/null; then
    if [ "$MIN_PUSH" != "1" ] &&
      ! pnpm -s bkit ci min-push --ref="$push_sha" < /dev/null > /dev/null; then
      echo "[pre-push] BLOCKED: $push_sha carries a CI-suppressing token and changes files outside bkit.minPushPaths — that code would land on dev / main with no CI run." >&2
      echo "[pre-push] Add a clean trigger commit and re-push:  git commit --allow-empty -m \"chore: trigger CI\" && git push" >&2
      exit 1
    fi
  fi
done

# tmp/ prune — deletes files under tmp/ untouched for 7+ days. Not a gate: a failed
# prune warns and the push goes on. Skipped until scripts/cleanup/ holds the script.
if [ -f scripts/cleanup/bkit-tmp-prune.mjs ]; then
  node scripts/cleanup/bkit-tmp-prune.mjs --days=7 < /dev/null ||
    echo "[pre-push] WARN: tmp/ prune failed; push continues" >&2
fi

# WHAT each gate runs lives in package.json, not here — the same `bkit:gate*` scripts
# the bkit agent workflows and prompts dispatch through. Edit the scripts, not this
# hook. Repo-specific extras go BELOW this block.
# Min push: `bkit:gate:min` only. Revert path drops the suite only: prose
# and slop:delta still run.
if [ "$MIN_PUSH" = "1" ]; then
  echo "[pre-push] min push — bkit:gate:min instead of the full gate" >&2
  pnpm bkit:gate:min < /dev/null
elif [ "$IS_REVERT" = "1" ]; then
  echo "[pre-push] revert branch/commit detected — skipping the test suite"
  pnpm bkit:gate:static < /dev/null
else
  pnpm bkit:gate:static-unit < /dev/null
fi

# bkit mirror-drift gate — fails fast if `.agents/*` was edited without `bkit install`
# regenerating the `.claude/*`/`.cursor/*` mirrors (same check CI runs).
# Outside the gate scripts: it validates the bkit install, not your source.
# Fix: `pnpm bkit install`, stage the regenerated files, commit, push.
pnpm bkit check < /dev/null

# Repo extras go here, above the disk prune. Slow ones (Docker, database, build) skip a
# min push:
#   if [ "$MIN_PUSH" != "1" ]; then pnpm <slow-script> < /dev/null; fi

# disk prune — keep this block last, so it runs only once every gate above passed. Starts
# your max cleanup steps (`bkit disk prune`, .bkit/templates.md § Disk prune) in the
# background, at most once a day, or hourly while free disk is under bkit.disk.minFreeGb;
# with no step files it does nothing. Not a gate: a failure warns and the push goes on.
pnpm -s bkit disk prune --mode=max --auto < /dev/null > /dev/null ||
  echo "[pre-push] WARN: disk prune failed; push continues" >&2
