# Claude Code harness — /schedule daemon lock
.claude/scheduled_tasks.lock

# Claude Code cloud setup doc — generated by `bkit install --claude`, inlines
# resolved secrets from .envrc; regenerated each install, never commit
.claude/cloud.md

# Claude Code harness — native worktree isolation (Agent isolation:worktree /
# EnterWorktree) checks out a full-tree copy here; transient, never commit —
# otherwise slop:delta double-counts the whole checked-out source tree
.claude/worktrees/

# cursor / opencode — no project-local worktree dir to ignore: cursor background
# agents run in remote VMs, and opencode runtime state is stored globally at
# ~/.local/share/opencode (XDG_DATA_HOME), not the project .opencode/ dir
# (confirmed by spike-verdict.md §(e): `opencode debug paths`). bkit-managed
# files in .opencode/ are tracked; no project-local runtime entries to ignore.

# husky 9 stub directory (auto-generated by `husky` from prepare script)
.husky/_

# Coverage reports (vitest --coverage) — regenerated each run, never committed
coverage/

# Playwright test artifacts — especially grow under [verbose ci]
test-results/
playwright-report/
blob-report/
.last-run.json
playwright/.auth/

# bkit advisories artifact — regenerated by every `bkit install` / `check` / `doctor`
.bkit/advisories.md

# local secrets for MCP servers / agent tooling — never commit
.bkit/.env

