{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(*)",
      "Bash(*)",
      "mcp__github__*",
      "mcp__claude_ai_Linear__*",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:linear.app)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:cursor.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:supabase.com)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME/*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(brew install:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(bun publish:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git restore .:*)",
      "Bash(git stash drop:*)",
      "Bash(git rebase -i:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh pr close:*)",
      "Bash(gh release delete:*)",
      "Bash(vercel rm:*)",
      "Bash(vercel remove:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase projects delete:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/preflight.sh"
          },
          {
            "type": "command",
            "command": "test -f .claude/hooks/cloud-bootstrap.sh && bash .claude/hooks/cloud-bootstrap.sh || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .claude/hooks/gateguard.cjs && node .claude/hooks/gateguard.cjs || true"
          }
        ]
      }
    ]
  }
}
