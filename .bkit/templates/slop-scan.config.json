{
  "ignores": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/*.generated.ts",
    "**/.agents/skills/**",
    "**/.claude/skills/**",
    "**/.cursor/skills/**"
  ],
  "plugins": {
    "boundary": "./.bkit/scripts/bkit-slop-type-suppression.mjs"
  },
  "rules": {
    "comments.placeholder-comments": {
      "enabled": true,
      "weight": 1.5
    },
    "boundary/type-suppression": {
      "enabled": true
    },
    "boundary/gate-suppression": {
      "enabled": true
    },
    "structure.over-fragmentation": {
      "enabled": true
    },
    "structure.directory-fanout-hotspot": {
      "enabled": true
    },
    "structure.duplicate-function-signatures": {
      "enabled": true
    },
    "structure.barrel-density": {
      "enabled": true
    },
    "structure.pass-through-wrappers": {
      "enabled": true
    },
    "defensive.empty-catch": {
      "enabled": true
    },
    "defensive.error-swallowing": {
      "enabled": true
    },
    "defensive.error-obscuring": {
      "enabled": true
    },
    "defensive.async-noise": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js"
      ],
      "rules": {
        "structure.duplicate-function-signatures": {
          "enabled": false
        },
        "tests.duplicate-mock-setup": {
          "enabled": false
        },
        "boundary/type-suppression": {
          "enabled": false
        }
      }
    },
    {
      "files": [".bkit/scripts/bkit-slop-type-suppression.mjs"],
      "rules": {
        "boundary/type-suppression": {
          "enabled": false
        },
        "boundary/gate-suppression": {
          "enabled": false
        }
      }
    },
    {
      "files": [".opencode/plugin/gateguard.js"],
      "rules": {
        "defensive.empty-catch": {
          "enabled": false
        }
      }
    },
    {
      "files": [
        "**/.claude/hooks/gateguard.cjs",
        "**/.cursor/hooks/gateguard.cjs",
        "**/.codex/hooks/gateguard.cjs",
        "**/.opencode/plugin/gateguard.js"
      ],
      "rules": {
        "structure.duplicate-function-signatures": {
          "enabled": false
        }
      }
    }
  ]
}
