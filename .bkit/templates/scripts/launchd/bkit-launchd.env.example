# Example. Copy into ~/.config/bkit/launchd.env and own it.
# bkit install does not write this file and does not overwrite a copy.
#
# Machine-local tokens for GUI apps (opencode desktop, Cursor) launched via Dock/Spotlight.
# Restrict permissions: chmod 600 ~/.config/bkit/launchd.env
#
# Format: KEY=VALUE (or export KEY="VALUE")
# Lines starting with # and blank lines are ignored.
#
BKIT_OPENROUTER_API_KEY=""
BKIT_GH_TOKEN=""
# BKIT_ANTHROPIC_API_KEY=""
# BKIT_OPENAI_API_KEY=""
