{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_BKIT_TOKEN}",
        "X-MCP-Toolsets": "context,issues,pull_requests,repos,users,projects,actions"
      }
    }
  }
}
