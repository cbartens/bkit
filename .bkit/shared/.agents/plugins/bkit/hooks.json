{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .agents/plugins/bkit/hooks/bkit-gateguard.cjs && node .agents/plugins/bkit/hooks/bkit-gateguard.cjs || true",
            "statusMessage": "bkit GateGuard"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "test -f .agents/plugins/bkit/hooks/bkit-guardrails.cjs && node .agents/plugins/bkit/hooks/bkit-guardrails.cjs || true",
            "statusMessage": "bkit guardrails"
          }
        ]
      }
    ]
  }
}
