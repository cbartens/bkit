{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.p12": "deny",
      "*id_rsa": "deny"
    },
    "edit": "allow",
    "grep": "allow",
    "glob": "allow",
    "task": "allow",
    "websearch": "allow",
    "webfetch": {
      "*": "ask"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "brew install*": "ask",
      "pnpm publish*": "ask",
      "npm publish*": "ask",
      "bun publish*": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "git clean -fdx*": "ask",
      "git filter-branch*": "ask",
      "git checkout -- .*": "ask",
      "git restore .*": "ask",
      "git stash drop*": "ask",
      "git rebase -i*": "ask",
      "gh repo delete*": "ask",
      "gh pr close*": "ask",
      "gh release delete*": "ask",
      "git reset *--hard*": "ask",
      "git clean -*f*": "ask",
      "git checkout *.": "ask",
      "git checkout * . *": "ask",
      "git restore *.": "ask",
      "git restore * . *": "ask",
      "git rebase * -i": "ask",
      "git rebase * -i *": "ask",
      "git rebase *--interactive*": "ask",
      "chmod -R 777 /*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME/*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "allow",
      "git * --no-verify": "ask",
      "git * --no-verify *": "ask",
      "git commit -n*": "ask",
      "git commit * -n": "ask",
      "git commit * -n *": "ask",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push * --force": "deny",
      "git push * --force *": "deny",
      "git push * -f*": "deny",
      "git push * +*": "deny",
      "git -* push* --force": "deny",
      "git -* push* --force *": "deny",
      "git -* push* -f*": "deny",
      "git -* push* +*": "deny",
      "git push* -uf*": "deny",
      "git -* push* -uf*": "deny",
      "git push* -vf*": "deny",
      "git -* push* -vf*": "deny",
      "git push* -qf*": "deny",
      "git -* push* -qf*": "deny",
      "git push* -nf*": "deny",
      "git -* push* -nf*": "deny",
      "git push* -df*": "deny",
      "git -* push* -df*": "deny",
      "git push* -4f*": "deny",
      "git -* push* -4f*": "deny",
      "git push* -6f*": "deny",
      "git -* push* -6f*": "deny"
    }
  },
  "mcp": {
    "@@OPENCODE_TRACKER_MCP@@": {}
  },
  "plugin": ["./plugin/bkit-gateguard.js", "./plugin/bkit-readguard.js"],
  "provider": {
    "@@OPENCODE_PROVIDER_KEY@@": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "@@OPENCODE_PROVIDER_KEY@@",
      "options": {
        "baseURL": "@@OPENCODE_PROVIDER_BASE_URL@@",
        "apiKey": "{env:@@OPENCODE_PROVIDER_ENV_VAR@@}"
      }
    }
  }
}
