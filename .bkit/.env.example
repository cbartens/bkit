# .bkit/.env — local secrets for MCP servers and agent tooling, shipped by bkit.
# Tier 3 (seed-or-print): bkit writes this file once if absent; if present
# bkit will not overwrite — see the install advisory for the recommended merge.
#
# Copy this file to .bkit/.env (gitignored), fill in your values, then run:
#   direnv allow
# direnv will auto-export these into your shell whenever you cd into this repo.
#
# Cloud sessions (Claude on the web, Cursor Background Agents) set the SAME
# variable names in their respective dashboards — never in this file.

# GH_BKIT_TOKEN — GitHub classic PAT with `read:packages` scope. Used by pnpm
# to authenticate to the GitHub Packages npm registry (npm.pkg.github.com) for
# @cbartens/* packages. Fine-grained PATs are rejected by GitHub Packages
# (HTTP 403) — must be classic.
# Generate at: https://github.com/settings/tokens (Tokens (classic) → Generate)
# The project .npmrc carries ONLY the @cbartens registry mapping; the auth token
# is written into pnpm's user-level config via `pnpm config set` (CI step, local
# once, Vercel installCommand) — version-proof across pnpm 10.x/11.x. pnpm >=10.34.3
# 401s on a project-.npmrc ${GH_BKIT_TOKEN} env-substitution. See KN-CORE-7.
GH_BKIT_TOKEN=

# GH_MCP_TOKEN — GitHub fine-grained PAT for the GitHub MCP server
# (api.githubcopilot.com/mcp/) via Authorization header in .mcp.json /
# .cursor/mcp.json. Required permissions: Contents R/W, Pull requests R/W,
# Issues R/W, Actions R/W, Workflows R/W, Metadata R. Scope to the repos you'll work on.
# Generate at: https://github.com/settings/personal-access-tokens
GH_MCP_TOKEN=

# LINEAR_API_KEY — Linear personal API key. Used by the Linear MCP server
# (mcp.linear.app/mcp) and by the Linear preflight hook in
# .claude/hooks/preflight.sh and .cursor/hooks/preflight.sh.
# Generate at: https://linear.app/settings/api
LINEAR_API_KEY=

# ANTHROPIC_API_KEY — Anthropic API key. Only needed if you run Claude Code
# without a Claude subscription (pay-per-token mode). Subscription users leave
# blank.
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# CURSOR_API_KEY — Cursor API key. Only needed if you dispatch Cursor cloud
# agents from this shell (programmatic POST /v0/agents, model catalog queries
# via `curl https://api.cursor.com/v0/models -u "$CURSOR_API_KEY:"`). The
# Cursor desktop IDE does NOT use this — it authenticates via its own login.
# Generate at: https://cursor.com/settings → API Keys
CURSOR_API_KEY=

# OPENCODE_API_KEY — OpenCode Zen gateway API key. Used with `bkit install --opencode=zen`
# (alias `--opencode=go`). Zen is opencode's own AI gateway; model ids are `opencode/<id>`.
# Generate at: https://opencode.ai/auth (sign in → Create API Key).
OPENCODE_API_KEY=

# NVIDIA_API_KEY — NVIDIA NIM API key. Used when opencode is installed with
# `bkit install --opencode=nvidia`. Routes opencode at NVIDIA's hosted
# OpenAI-compatible endpoint (integrate.api.nvidia.com/v1). Free tier available.
# Key format: nvapi-…
# Generate at: https://build.nvidia.com/models (pick any model → "Get API Key").
NVIDIA_API_KEY=

# GROQ_API_KEY — Groq API key. Used with `bkit install --opencode=groq`. Free tier;
# fast OpenAI-compatible endpoint (api.groq.com/openai/v1). Key format: gsk_…
# Generate at: https://console.groq.com/keys
GROQ_API_KEY=

# CEREBRAS_API_KEY — Cerebras API key. Used with `bkit install --opencode=cerebras`.
# Free tier; OpenAI-compatible endpoint (api.cerebras.ai/v1) at top inference speed.
# Generate at: https://cloud.cerebras.ai (API Keys).
CEREBRAS_API_KEY=

# OPENROUTER_API_KEY — OpenRouter API key. Used with `bkit install --opencode=openrouter`.
# One key → every model (incl. :free variants) via openrouter.ai/api/v1. Key format: sk-or-…
# Generate at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OLLAMA_API_KEY — Ollama Cloud API key. Used with `bkit install --opencode=ollama`
# (CLOUD-hosted Ollama at ollama.com/v1 — distinct from `--opencode=ollama-local`, which
# is the local server and needs NO key). Generate at: https://ollama.com/settings/keys
OLLAMA_API_KEY=
