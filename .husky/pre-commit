#!/usr/bin/env sh
# bkit pre-commit. Example. Copy into the repo and own it.
# bkit install does not write this file and does not overwrite a copy.
#
# FAST local gate only: format staged files (seconds). Heavier gates
# (typecheck/unit/format:check/prose), the enforcing slop gate (slop:delta) and the
# integration tier are in pre-push; E2E/@live run ONLY in CI (bkit-tests / bkit-tests-live,
# enforced by bkit-tests-check) — see bkit-ci.yml § FULL CI SCAFFOLD REFERENCE. Rule: nothing
# here that pre-push runs again, and nothing that takes more than a few seconds. (lint:slop is `slop-scan scan` — report-only, never
# fails; the gate that fails on NEW findings is `slop:delta`, which runs in pre-push.)
#
# WHAT it runs lives in package.json `bkit:gate:format`, not here — the same script
# the bkit agent workflows dispatch through; change the gate there. Add repo-specific
# extras BELOW this line.
set -e
pnpm bkit:gate:format

# env backup — an encrypted .enc copy beside each env file (.bkit/templates.md § Env backup).
# No key on this machine: warns, the commit goes on. A setup error, or a key without sops, stops it.
if [ -f scripts/env-backup/bkit-env-backup.mjs ]; then
  node scripts/env-backup/bkit-env-backup.mjs encrypt < /dev/null
fi

# bkit repo only: a staged non-test `.bkit/core/engine/**/*.ts` runs the dist freshness check.
if git diff --cached --name-only --diff-filter=ACM |
  grep -v '\.test\.ts$' |
  grep -q '^\.bkit/core/engine/.*\.ts$'; then
  pnpm bkit:check:dist < /dev/null
fi

# disk prune — keep this block last. Starts your min cleanup steps (`bkit disk prune`,
# .bkit/templates.md § Disk prune) in the background, at most once a day; with no step
# files it does nothing. Not a gate: a failure warns and the commit goes on.
pnpm -s bkit disk prune --mode=min --auto < /dev/null > /dev/null ||
  echo "[pre-commit] WARN: disk prune failed; commit continues" >&2
