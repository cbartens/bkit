#!/usr/bin/env sh
set -e
# lint:slop (scan) is report-only and never fails — it moved to pre-push as the
# enforcing `slop:delta` gate. pre-commit stays fast: format staged + prose.
pnpm lint-staged && pnpm lint:prose

# bkit-repo only — block committing stale dist when a COMPILED `.bkit/src/*.ts` is
# staged. Consumers don't compile TS and never run this gate.
# Test files are excluded: they emit nothing into dist/, but check:dist rebuilds from
# the WORKING TREE, so a test-only commit made while any source edit is still
# uncommitted would fail on a diff it did not cause and cannot fix.
if git diff --cached --name-only --diff-filter=ACM |
  grep -v '\.test\.ts$' |
  grep -q '^\.bkit/src/.*\.ts$'; then
  pnpm check:dist < /dev/null
fi
