#!/usr/bin/env sh
# pre-push hook shipped by bkit. Tier 3 (seed-or-print): bkit writes this file
# once if absent; if present bkit will not overwrite — modify freely.
#
# Revert-branch bypass: when rolling back, the source tree is intentionally
# inconsistent (deleted files referenced by surviving tests). Skip the test
# suite so the recovery push can land; lint + typecheck still run.
set -e
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
HEAD_SUBJECT=$(git log -1 --pretty=%s 2>/dev/null || echo "")
IS_REVERT=0
case "$BRANCH" in
  revert-*) IS_REVERT=1 ;;
esac
case "$HEAD_SUBJECT" in
  'Revert "'*) IS_REVERT=1 ;;
esac

# CI-suppressor HEAD guard. A [skip ci]-class token on the HEAD commit of a branch with an
# OPEN PR silences GitHub's pull_request trigger -> empty statusCheckRollup -> a PR that
# merges without ever running CI. The workflow CI-Dispatch gate only covers the push it
# makes at close; this backstops MANUAL pushes (rebase + force-push, post-close commits).
# Conditioned on an open PR so it never blocks sanctioned [skip ci] pushes with no PR
# (mid-loop status, abort handover). dev/main exempt; gh absent -> allow (backstop only).
case "$BRANCH" in
  dev|main) ;;
  *)
    if git log -1 --pretty=%B | grep -iEq '\[skip ci\]|\[ci skip\]|\[no ci\]|\[skip actions\]|\[actions skip\]'; then
      if command -v gh >/dev/null 2>&1; then
        # strip hook-injected GIT_DIR/GIT_WORK_TREE so gh resolves the repo from cwd (worktree-safe)
        OPEN_PR=$(env -u GIT_DIR -u GIT_WORK_TREE gh pr list --head "$BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null || echo "")
        if [ -n "$OPEN_PR" ]; then
          echo "[pre-push] BLOCKED: HEAD on '$BRANCH' carries a CI-suppressing token and PR #$OPEN_PR is open — its checks would stay vacuously green." >&2
          echo "[pre-push] Add a clean trigger commit and re-push:  git commit --allow-empty -m \"chore: trigger CI\" && git push" >&2
          exit 1
        fi
      else
        echo "[pre-push] WARN: HEAD on '$BRANCH' carries a CI-suppressing token but gh is unavailable to check for an open PR; allowing. If a PR is open, ensure HEAD triggers CI." >&2
      fi
    fi
    ;;
esac

# WHAT each gate runs lives in package.json `bkit:gate*` — the same scripts the agent
# workflows and prompts dispatch through, so a human push and an agent run enforce the
# identical set. Edit the scripts, not this hook. bkit-repo-only extras stay below.
# Revert path drops the suite only: prose and slop:delta stay (md prose is unaffected by
# deleted code; removals show as 'resolved', never 'added', so slop:delta stays green).
# bats runs inside `bkit:gate` and self-guards when the binary is absent — it is NOT a
# devDependency (CI installs it via `npx --yes bats`), and without the guard a
# contributor who has not installed bats could not push at all.
if [ "$IS_REVERT" = "1" ]; then
  echo "[pre-push] revert branch/commit detected — skipping the test suite"
  pnpm bkit:gate:static < /dev/null
else
  pnpm bkit:gate:static-unit < /dev/null
fi

# bkit-repo only — fail push if `.agents/*` edits weren't mirrored via `pnpm bkit install`.
pnpm bkit check < /dev/null

# bkit-repo only — verify committed `dist/` matches `tsc` output of committed source.
# Consumers don't have TS to compile and never run this gate.
pnpm bkit:check:dist < /dev/null

# bkit-repo only — actionlint validates `.github/workflows/*` (YAML parse is not enough).
# Guard-skips when actionlint is absent; install actionlint to enforce.
pnpm bkit:lint:workflows < /dev/null
